--- a/src/ubm-gatt-state.h	1969-12-31 16:00:00
+++ b/src/ubm-gatt-state.h	2026-09-27 22:02:54
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef UBM_GATT_STATE_H
+#define UBM_GATT_STATE_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <errno.h>
+
+enum ubm_gatt_bearer { UBM_GATT_NONE, UBM_GATT_LE, UBM_GATT_BREDR,
+							UBM_GATT_MIXED, UBM_GATT_UNKNOWN };
+enum ubm_gatt_status { UBM_GATT_DISCONNECTED, UBM_GATT_DISCOVERING,
+	UBM_GATT_READY, UBM_GATT_FAILED, UBM_GATT_UNSUPPORTED };
+struct ubm_gatt_state {
+	uint64_t attachment;
+	uint64_t revision;
+	enum ubm_gatt_bearer bearer;
+	enum ubm_gatt_status status;
+	int error;
+	uint8_t att_error;
+	const char *failure_stage;
+	bool exhausted;
+	bool retired;
+};
+
+/* One cycle includes every accepted queued invalidation and hash check. */
+struct ubm_gatt_refresh {
+	uint64_t pending;
+	bool failed;
+	bool exhausted;
+	uint8_t att_error;
+};
+static inline void ubm_gatt_refresh_begin(struct ubm_gatt_refresh *refresh)
+{
+	if (!refresh->pending && !refresh->exhausted) {
+		refresh->failed = false;
+		refresh->att_error = 0;
+	}
+	if (refresh->pending == UINT64_MAX) {
+		refresh->failed = true;
+		refresh->exhausted = true;
+		return;
+	}
+	refresh->pending++;
+}
+static inline bool ubm_gatt_refresh_finish(struct ubm_gatt_refresh *refresh,
+						bool success, uint8_t att_error)
+{
+	if (refresh->exhausted)
+		return false;
+	if (!success && !refresh->failed) {
+		refresh->failed = true;
+		refresh->att_error = att_error;
+	}
+	if (refresh->pending)
+		refresh->pending--;
+	return !refresh->pending;
+}
+
+static inline enum ubm_gatt_status ubm_gatt_status(
+					const struct ubm_gatt_state *state)
+{
+	return state->status;
+}
+
+static inline void ubm_gatt_begin(struct ubm_gatt_state *state)
+{
+	if (state->revision == UINT64_MAX || state->exhausted) {
+		state->exhausted = true;
+		state->status = UBM_GATT_FAILED;
+		state->error = EOVERFLOW;
+		state->failure_stage = NULL;
+		return;
+	}
+	state->revision++;
+	state->att_error = 0;
+	state->failure_stage = NULL;
+	if (state->bearer == UBM_GATT_NONE || state->retired) {
+		state->status = UBM_GATT_DISCONNECTED;
+		state->error = ENOTCONN;
+		return;
+	}
+	state->error = state->bearer == UBM_GATT_LE ? 0 : EOPNOTSUPP;
+	state->status = state->bearer == UBM_GATT_LE ?
+				UBM_GATT_DISCOVERING : UBM_GATT_UNSUPPORTED;
+}
+
+/* The caller supplies only a bearer read from the accepted ATT socket. */
+static inline void ubm_gatt_attach(struct ubm_gatt_state *state,
+						enum ubm_gatt_bearer bearer)
+{
+	if (state->bearer != UBM_GATT_NONE) {
+		if (state->bearer != bearer) {
+			state->bearer = UBM_GATT_MIXED;
+			ubm_gatt_begin(state);
+		}
+		return;
+	}
+	if (state->attachment == UINT64_MAX) {
+		state->exhausted = true;
+		ubm_gatt_begin(state);
+		return;
+	}
+	state->attachment++;
+	state->retired = false;
+	state->bearer = bearer;
+	ubm_gatt_begin(state);
+}
+
+static inline void ubm_gatt_complete(struct ubm_gatt_state *state,
+						bool success, uint8_t att_error)
+{
+	if (state->exhausted || state->retired || state->bearer == UBM_GATT_NONE)
+		return;
+	if (state->bearer != UBM_GATT_LE) {
+		state->status = UBM_GATT_UNSUPPORTED;
+		state->error = EOPNOTSUPP;
+		return;
+	}
+	state->status = success ? UBM_GATT_READY : UBM_GATT_FAILED;
+	state->failure_stage = NULL;
+	state->error = success ? 0 : EIO;
+	state->att_error = att_error;
+}
+
+static inline void ubm_gatt_retire(struct ubm_gatt_state *state)
+{
+	ubm_gatt_begin(state);
+	state->retired = true;
+	if (state->exhausted)
+		return;
+	state->status = UBM_GATT_DISCONNECTED;
+	state->error = ENOTCONN;
+	state->att_error = 0;
+}
+static inline void ubm_gatt_detach(struct ubm_gatt_state *state)
+{
+	ubm_gatt_retire(state);
+	state->bearer = UBM_GATT_NONE;
+}
+#endif
diff -ruN a/unit/test-ubm-device.c b/unit/test-ubm-device.c
--- a/unit/test-ubm-device.c	1969-12-31 16:00:00
+++ b/unit/test-ubm-device.c	2026-09-27 22:00:40
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Actual private method table/handler on a private D-Bus session only. */
+#include "src/device.c"
+#include <assert.h>
+#include <stdio.h>
+
+static bool projection_complete = true;
+struct btd_opts btd_opts;
+bool btd_gatt_client_projection_complete(struct btd_gatt_client *client)
+{
+	(void) client;
+	return projection_complete;
+}
+static GMainLoop *loop;
+static DBusMessage *received;
+static void reply_received(DBusPendingCall *pending, void *data)
+{
+	(void) data;
+	received = dbus_pending_call_steal_reply(pending);
+	g_main_loop_quit(loop);
+}
+static gboolean watchdog(void *data)
+{
+	(void) data;
+	fprintf(stderr, "private GetSnapshot did not reply\n");
+	abort();
+}
+static void snapshot(DBusConnection *client, const char *expected_status,
+					const char *expected_stage, int expected_error)
+{
+	DBusMessage *request;
+	DBusPendingCall *pending;
+	const char *bearer, *status, *stage;
+	uint32_t version;
+	uint64_t attachment, revision;
+	uint8_t att_error;
+	int32_t error;
+	guint timeout;
+	request = dbus_message_new_method_call("org.ubm.Test", "/org/bluez/test",
+					UBM_LE_GATT_INTERFACE, "GetSnapshot");
+	assert(dbus_connection_send_with_reply(client, request, &pending, 5000));
+	assert(dbus_pending_call_set_notify(pending, reply_received, NULL, NULL));
+	timeout = g_timeout_add_seconds(6, watchdog, NULL);
+	g_main_loop_run(loop);
+	g_source_remove(timeout);
+	assert(received && dbus_message_get_type(received) == DBUS_MESSAGE_TYPE_METHOD_RETURN);
+	assert(!strcmp(dbus_message_get_signature(received), "uttsssiy"));
+	assert(dbus_message_get_args(received, NULL, DBUS_TYPE_UINT32, &version,
+		DBUS_TYPE_UINT64, &attachment, DBUS_TYPE_UINT64, &revision,
+		DBUS_TYPE_STRING, &bearer, DBUS_TYPE_STRING, &status,
+		DBUS_TYPE_STRING, &stage, DBUS_TYPE_INT32, &error,
+		DBUS_TYPE_BYTE, &att_error, DBUS_TYPE_INVALID));
+	assert(version == 1 && attachment > 0 && revision > 0);
+	assert(!strcmp(status, expected_status));
+	assert(!strcmp(stage, expected_stage) && error == expected_error);
+	dbus_message_unref(received);
+	received = NULL;
+	dbus_pending_call_unref(pending);
+	dbus_message_unref(request);
+}
+int main(void)
+{
+	DBusConnection *client;
+	DBusError error = DBUS_ERROR_INIT;
+	struct btd_device device = { 0 };
+	struct btd_device replacement = { 0 };
+	struct ubm_client_watch old_watch = { .device = &device };
+	struct ubm_client_watch watch = { .device = &device, .attachment = 1,
+							.initial_ready = true };
+	device.le_state.connected = true;
+	device.path = "/org/bluez/test";
+	/* Exercise the exact production policy decision, before allocation. */
+	ubm_attach_primary(&device, BDADDR_LE_PUBLIC);
+	assert(ubm_fresh_initial_gatt(&device));
+	device.ubm_gatt.bearer = UBM_GATT_LE;
+	assert(ubm_fresh_initial_gatt(&device));
+	device.ubm_gatt.bearer = UBM_GATT_MIXED;
+	assert(!ubm_fresh_initial_gatt(&device));
+	device.ubm_gatt.bearer = UBM_GATT_LE;
+	btd_opts.reverse_discovery = false;
+	btd_opts.gatt_client = true;
+	assert(!ubm_gatt_init_allowed(&device));
+	assert(device.ubm_gatt.status == UBM_GATT_UNSUPPORTED);
+	ubm_gatt_begin(&device.ubm_gatt);
+	btd_opts.reverse_discovery = true;
+	btd_opts.gatt_client = false;
+	assert(!ubm_gatt_init_allowed(&device));
+	assert(device.ubm_gatt.status == UBM_GATT_UNSUPPORTED);
+	btd_opts.gatt_client = true;
+	assert(ubm_gatt_init_allowed(&device));
+	ubm_gatt_registration_failed(&device);
+	assert(device.ubm_gatt.status == UBM_GATT_FAILED);
+	assert(!strcmp(device.ubm_gatt.failure_stage, "registration"));
+	ubm_gatt_detach(&device.ubm_gatt);
+	ubm_attach_primary(&replacement, 255);
+	assert(!ubm_fresh_initial_gatt(&replacement));
+	ubm_gatt_complete(&replacement.ubm_gatt, true, 0);
+	assert(replacement.ubm_gatt.status == UBM_GATT_UNSUPPORTED);
+	/* This independent device must not alter the first receipt's identity. */
+	ubm_attachment_serial = 0;
+	ubm_attach_primary(&device, BDADDR_LE_PUBLIC);
+	ubm_gatt_complete(&device.ubm_gatt, true, 0);
+	device.ubm_watch = &watch;
+	ubm_discovery_observed(true, false, 0, 0, &old_watch);
+	assert(device.ubm_gatt.status == UBM_GATT_READY);
+	dbus_conn = g_dbus_setup_private(DBUS_BUS_SESSION, "org.ubm.Test", &error);
+	assert(dbus_conn);
+	client = g_dbus_setup_private(DBUS_BUS_SESSION, NULL, &error);
+	assert(client);
+	assert(g_dbus_register_interface(dbus_conn, device.path,
+		UBM_LE_GATT_INTERFACE, ubm_gatt_methods, ubm_gatt_signals,
+						NULL, &device, NULL));
+	loop = g_main_loop_new(NULL, FALSE);
+	snapshot(client, "ready", "none", 0);
+	projection_complete = false;
+	snapshot(client, "failed", "projection", EIO);
+	projection_complete = true;
+	ubm_discovery_observed(true, false, 0, 0, &watch);
+	snapshot(client, "discovering", "none", 0);
+	ubm_discovery_observed(false, false, EIO, 0x05, &watch);
+	snapshot(client, "failed", "discovery", EIO);
+	ubm_discovery_observed(false, true, 0, 0, &watch);
+	snapshot(client, "ready", "none", 0);
+	device.le_state.connected = false;
+	snapshot(client, "disconnected", "transport", ENOTCONN);
+	device.le_state.connected = true;
+	ubm_gatt_attach(&device.ubm_gatt, UBM_GATT_BREDR);
+	assert(!ubm_fresh_initial_gatt(&device));
+	snapshot(client, "unsupported", "bearer", EOPNOTSUPP);
+	/* The actual wrapper rejects an old completion after a new ATT epoch,
+	 * even if that old watch is still presented as the device's watch. */
+	ubm_gatt_detach(&device.ubm_gatt);
+	ubm_attach_primary(&replacement, BDADDR_LE_PUBLIC);
+	ubm_attach_primary(&device, BDADDR_LE_PUBLIC);
+	assert(device.ubm_gatt.attachment != replacement.ubm_gatt.attachment);
+	assert(device.ubm_gatt.attachment != watch.attachment);
+	ubm_discovery_observed(false, true, 0, 0, &watch);
+	assert(device.ubm_gatt.status == UBM_GATT_DISCOVERING);
+	snapshot(client, "discovering", "none", 0);
+	/* The same physical generation still rejects a stale client identity. */
+	watch.attachment = device.ubm_gatt.attachment;
+	watch.client = (struct bt_gatt_client *) &old_watch;
+	ubm_discovery_observed(false, true, 0, 0, &watch);
+	assert(device.ubm_gatt.status == UBM_GATT_DISCOVERING);
+	/* Exhaustion never recycles a ready receipt, across device recreation. */
+	ubm_attachment_serial = UINT64_MAX;
+	ubm_gatt_detach(&device.ubm_gatt);
+	ubm_attach_primary(&device, BDADDR_LE_PUBLIC);
+	ubm_gatt_complete(&device.ubm_gatt, true, 0);
+	snapshot(client, "failed", "generation", EOVERFLOW);
+	g_dbus_unregister_interface(dbus_conn, device.path, UBM_LE_GATT_INTERFACE);
+	g_main_loop_unref(loop);
+	dbus_connection_close(client);
+	dbus_connection_unref(client);
+	dbus_connection_close(dbus_conn);
+	dbus_connection_unref(dbus_conn);
+	puts("Production private method/ownership/error envelope: OK");
+	return 0;
+}
diff -ruN a/unit/test-ubm-gatt-projection.c b/unit/test-ubm-gatt-projection.c
--- a/unit/test-ubm-gatt-projection.c	1969-12-31 16:00:00
+++ b/unit/test-ubm-gatt-projection.c	2026-09-27 22:01:09
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Exercise the production graph predicate; no system bus or radio. */
+#include "src/gatt-client.c"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void)
+{
+	struct btd_gatt_client client = { .ready = true };
+	struct service service = { .client = &client };
+	struct characteristic chrc = { .service = &service };
+	struct descriptor descriptor = { .chrc = &chrc };
+	struct service included = { .client = &client };
+	struct gatt_db_attribute *attr, *value;
+	struct gatt_db *stale_db;
+	bt_uuid_t uuid;
+	client.db = gatt_db_new();
+	client.services = queue_new();
+	service.chrcs = queue_new();
+	service.incl_services = queue_new();
+	chrc.descs = queue_new();
+	assert(btd_gatt_client_projection_complete(&client));
+	bt_uuid16_create(&uuid, 0x180d);
+	attr = gatt_db_add_service(client.db, &uuid, true, 8);
+	assert(attr);
+	gatt_db_service_set_active(attr, true);
+	gatt_db_attribute_get_service_data(attr, &service.start_handle,
+		&service.end_handle, &service.primary, &service.uuid);
+	/* Native discovery succeeded, but service export failed. */
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_push_tail(client.services, &service);
+	assert(btd_gatt_client_projection_complete(&client));
+	bt_uuid16_create(&uuid, 0x2a37);
+	value = gatt_db_service_add_characteristic(attr, &uuid, 0, 2,
+						NULL, NULL, NULL);
+	assert(value);
+	/* Surviving service object does not hide failed characteristic export. */
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.attr = value;
+	gatt_db_attribute_get_char_data(gatt_db_get_attribute(client.db,
+		gatt_db_attribute_get_handle(value) - 1), &chrc.handle,
+		&chrc.value_handle, &chrc.props, &chrc.ext_props, &chrc.uuid);
+	queue_push_tail(service.chrcs, &chrc);
+	assert(btd_gatt_client_projection_complete(&client));
+	/* Exported characteristic owns the value attribute, not declaration. */
+	chrc.attr = gatt_db_get_attribute(client.db, chrc.handle);
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.attr = value;
+	stale_db = gatt_db_clone(client.db);
+	assert(stale_db);
+	chrc.attr = gatt_db_get_attribute(stale_db, chrc.value_handle);
+	assert(chrc.attr && chrc.attr != value);
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.attr = value;
+	gatt_db_unref(stale_db);
+	chrc.attr = NULL;
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.attr = value;
+	chrc.handle++;
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.handle--;
+	chrc.value_handle++;
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.value_handle--;
+	assert(btd_gatt_client_projection_complete(&client));
+	bt_uuid16_create(&uuid, 0x2902);
+	descriptor.attr = gatt_db_service_add_descriptor(attr, &uuid, 0,
+						NULL, NULL, NULL);
+	assert(descriptor.attr);
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_push_tail(chrc.descs, &descriptor);
+	descriptor.handle = gatt_db_attribute_get_handle(descriptor.attr);
+	descriptor.uuid = *gatt_db_attribute_get_type(descriptor.attr);
+	assert(btd_gatt_client_projection_complete(&client));
+	chrc.props = 0;
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.props = 2;
+	/* D-Bus Includes intentionally deduplicates multiple native declarations
+	 * that point to one service. Completeness is about exported unique edges. */
+	bt_uuid16_create(&uuid, 0x180f);
+	value = gatt_db_add_service(client.db, &uuid, true, 4);
+	assert(value);
+	gatt_db_service_set_active(value, true);
+	included.chrcs = queue_new();
+	included.incl_services = queue_new();
+	gatt_db_attribute_get_service_data(value, &included.start_handle,
+		&included.end_handle, &included.primary, &included.uuid);
+	queue_push_tail(client.services, &included);
+	assert(gatt_db_service_add_included(attr, value));
+	assert(gatt_db_service_add_included(attr, value));
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_push_tail(service.incl_services, &included);
+	assert(btd_gatt_client_projection_complete(&client));
+	included.end_handle++;
+	assert(!btd_gatt_client_projection_complete(&client));
+	included.end_handle--;
+	queue_remove(service.incl_services, &included);
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_push_tail(service.incl_services, &included);
+	/* Extra cached objects are also not a complete current projection. */
+	queue_push_tail(chrc.descs, &descriptor);
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_destroy(chrc.descs, NULL);
+	queue_destroy(included.chrcs, NULL);
+	queue_destroy(included.incl_services, NULL);
+	queue_destroy(service.incl_services, NULL);
+	queue_destroy(service.chrcs, NULL);
+	queue_destroy(client.services, NULL);
+	gatt_db_unref(client.db);
+	puts("Production export graph completeness: OK");
+	return 0;
+}
diff -ruN a/unit/test-ubm-gatt-state.c b/unit/test-ubm-gatt-state.c
--- a/unit/test-ubm-gatt-state.c	1969-12-31 16:00:00
+++ b/unit/test-ubm-gatt-state.c	2026-09-27 22:02:53
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include "src/ubm-gatt-state.h"
+
+int main(void)
+{
+	struct ubm_gatt_state state = { 0 };
+	uint64_t attachment, revision;
+	struct ubm_gatt_refresh refresh = { 0 };
+
+	ubm_gatt_refresh_begin(&refresh);
+	ubm_gatt_refresh_begin(&refresh);
+	assert(!ubm_gatt_refresh_finish(&refresh, false, 0x05));
+	assert(refresh.pending == 1 && refresh.failed && refresh.att_error == 5);
+	assert(ubm_gatt_refresh_finish(&refresh, true, 0));
+	assert(refresh.failed && refresh.att_error == 5);
+	ubm_gatt_refresh_begin(&refresh);
+	assert(!refresh.failed);
+	assert(ubm_gatt_refresh_finish(&refresh, true, 0));
+	assert(!refresh.failed && refresh.pending == 0);
+	refresh.pending = UINT64_MAX;
+	ubm_gatt_refresh_begin(&refresh);
+	assert(refresh.exhausted && refresh.failed);
+	assert(!ubm_gatt_refresh_finish(&refresh, true, 0));
+	assert(refresh.pending == UINT64_MAX);
+
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCONNECTED);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	attachment = state.attachment;
+	assert(attachment != 0);
+	ubm_gatt_begin(&state);
+	revision = state.revision;
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCOVERING);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_READY);
+	assert(state.attachment == attachment && state.revision == revision);
+	ubm_gatt_retire(&state);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	ubm_gatt_complete(&state, true, 0);
+	assert(state.status == UBM_GATT_DISCONNECTED && state.attachment == attachment);
+	ubm_gatt_detach(&state);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	attachment = state.attachment;
+	ubm_gatt_complete(&state, true, 0);
+
+	/* An accepted invalidation precedes completion/export of a refresh. */
+	ubm_gatt_begin(&state);
+	assert(state.revision > revision);
+	assert(ubm_gatt_status(&state) != UBM_GATT_READY);
+	ubm_gatt_complete(&state, false, 0x05);
+	assert(ubm_gatt_status(&state) == UBM_GATT_FAILED);
+	assert(state.error == EIO && state.att_error == 0x05);
+	ubm_gatt_begin(&state);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_READY);
+
+	/* A second transport cannot turn the shared client into LE evidence. */
+	ubm_gatt_attach(&state, UBM_GATT_BREDR);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_UNSUPPORTED);
+	assert(state.bearer == UBM_GATT_MIXED && state.error == EOPNOTSUPP);
+	ubm_gatt_detach(&state);
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCONNECTED);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCONNECTED);
+	ubm_gatt_attach(&state, UBM_GATT_BREDR);
+	ubm_gatt_begin(&state);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_UNSUPPORTED);
+	ubm_gatt_detach(&state);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	assert(state.attachment > attachment);
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCOVERING);
+
+	/* Counter wrap is a terminal refusal, never a recycled receipt. */
+	state.revision = UINT64_MAX;
+	ubm_gatt_begin(&state);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_FAILED);
+	assert(state.error == EOVERFLOW);
+	ubm_gatt_detach(&state);
+	assert(state.status == UBM_GATT_FAILED && state.error == EOVERFLOW);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	ubm_gatt_complete(&state, true, 0);
+	assert(state.status == UBM_GATT_FAILED && state.error == EOVERFLOW);
+	puts("LE GATT ownership/status lifecycle: OK");
+	return 0;
+}
diff -ruN a/unit/test-ubm-refresh.c b/unit/test-ubm-refresh.c
--- a/unit/test-ubm-refresh.c	1969-12-31 16:00:00
+++ b/unit/test-ubm-refresh.c	2026-09-27 21:58:48
@@ -0,0 +1,253 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+/* Production invalidation/completion paths with no ATT socket or radio. */
+#include "src/shared/gatt-client.c"
+#include <stdio.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <glib.h>
+
+struct cache_answer {
+	bool done, success, refuse;
+	unsigned int primary;
+	uint8_t *hash;
+};
+static void cache_ready(bool success, uint8_t error, void *data)
+{
+	struct cache_answer *answer = data;
+	(void) error;
+	answer->done = true;
+	answer->success = success;
+}
+static gboolean cache_respond(GIOChannel *io, GIOCondition condition, void *data)
+{
+	struct cache_answer *answer = data;
+	uint8_t request[64], response[32];
+	int fd = g_io_channel_unix_get_fd(io);
+	ssize_t length = read(fd, request, sizeof(request));
+	uint16_t start, type;
+	size_t size = 5;
+	(void) condition;
+	assert(length >= 5);
+	start = get_le16(request + 1);
+	type = length >= 7 ? get_le16(request + 5) : 0;
+	response[0] = BT_ATT_OP_ERROR_RSP;
+	response[1] = request[0];
+	put_le16(start, response + 2);
+	response[4] = BT_ATT_ERROR_ATTRIBUTE_NOT_FOUND;
+	if (request[0] == BT_ATT_OP_READ_BY_GRP_TYPE_REQ && type == 0x2800) {
+		answer->primary++;
+		if (answer->refuse) {
+			/* A malformed accepted response settles with no ATT error. */
+			response[0] = BT_ATT_OP_READ_BY_GRP_TYPE_RSP;
+			response[1] = 6;
+			size = 2;
+		} else if (start == 1) {
+			uint8_t service[] = { 0x11, 6, 1, 0, 8, 0, 1, 0x18 };
+			memcpy(response, service, sizeof(service));
+			size = sizeof(service);
+		}
+	} else if (request[0] == BT_ATT_OP_READ_BY_TYPE_REQ && type == 0x2b2a) {
+		response[0] = BT_ATT_OP_READ_BY_TYPE_RSP;
+		response[1] = 18;
+		put_le16(3, response + 2);
+		memcpy(response + 4, answer->hash, 16);
+		size = 20;
+	} else if (request[0] == BT_ATT_OP_READ_BY_TYPE_REQ && type == 0x2803 && start <= 4) {
+		uint8_t characteristics[] = { 0x09, 7, 2, 0, 2, 3, 0, 0x2a, 0x2b,
+						4, 0, 2, 5, 0, 0x38, 0x2a };
+		memcpy(response, characteristics, sizeof(characteristics));
+		size = sizeof(characteristics);
+	}
+	assert(write(fd, response, size) == (ssize_t) size);
+	return G_SOURCE_CONTINUE;
+}
+static void cache_written(struct gatt_db_attribute *attr, int error, void *data)
+{
+	(void) attr;
+	(void) data;
+	assert(!error);
+}
+static struct gatt_db *cache_database(uint8_t *hash)
+{
+	struct gatt_db *db = gatt_db_new();
+	struct gatt_db_attribute *service, *value;
+	bt_uuid_t uuid;
+	bt_uuid16_create(&uuid, 0x1801);
+	service = gatt_db_add_service(db, &uuid, true, 8);
+	assert(service);
+	bt_uuid16_create(&uuid, GATT_CHARAC_DB_HASH);
+	value = gatt_db_service_add_characteristic(service, &uuid,
+		BT_ATT_PERM_READ, BT_GATT_CHRC_PROP_READ,
+		NULL, NULL, NULL);
+	assert(value);
+	assert(gatt_db_attribute_write(value, 0, hash, 16, 0, NULL,
+						cache_written, NULL));
+	bt_uuid16_create(&uuid, 0x2a37);
+	assert(gatt_db_service_add_characteristic(service, &uuid,
+		BT_ATT_PERM_READ, BT_GATT_CHRC_PROP_READ, NULL, NULL, NULL));
+	gatt_db_service_set_active(service, true);
+	return db;
+}
+static void cache_session(struct gatt_db *db, struct cache_answer *answer,
+							bool fresh)
+{
+	int sockets[2];
+	struct bt_att *client_att;
+	struct bt_gatt_client *client;
+	GIOChannel *io;
+	guint watch;
+	assert(!socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets));
+	client_att = bt_att_new(sockets[0], false);
+	assert(client_att);
+	io = g_io_channel_unix_new(sockets[1]);
+	watch = g_io_add_watch(io, G_IO_IN, cache_respond, answer);
+	assert(watch);
+	client = fresh ? bt_gatt_client_new_fresh(db, client_att, 23, 0) :
+				bt_gatt_client_new(db, client_att, 23, 0);
+	assert(client);
+	assert(bt_gatt_client_ready_register(client, cache_ready, answer, NULL));
+	/* The alarm is a failure-only watchdog, never a readiness verdict. */
+	alarm(10);
+	while (!answer->done)
+		g_main_context_iteration(NULL, true);
+	alarm(0);
+	bt_gatt_client_unref(client);
+	g_source_remove(watch);
+	g_io_channel_unref(io);
+	bt_att_unref(client_att);
+	close(sockets[0]);
+	close(sockets[1]);
+}
+static void initial_cache_test(bool interrupted, bool matching)
+{
+	uint8_t old_hash[16] = { 1 }, new_hash[16] = { 2 };
+	if (matching)
+		old_hash[0] = new_hash[0];
+	struct gatt_db *db = cache_database(old_hash);
+	struct cache_answer answer = { .refuse = interrupted, .hash = new_hash };
+	struct gatt_db_attribute *hash;
+	const uint8_t *stored = NULL;
+	bt_uuid_t expected;
+	cache_session(db, &answer, true);
+	if (interrupted) {
+		assert(!answer.success && answer.primary > 0);
+		hash = gatt_db_get_attribute(db, 3);
+		if (hash)
+			gatt_db_attribute_read(hash, 0, 0, NULL,
+						db_hash_read_value_cb, &stored);
+		assert(!stored || memcmp(stored, new_hash, 16));
+		answer = (struct cache_answer) { .hash = new_hash };
+		cache_session(db, &answer, true);
+		assert(answer.primary > 0);
+	}
+	assert(answer.success);
+	bt_uuid16_create(&expected, 0x2a38);
+	assert(gatt_db_get_attribute(db, 5));
+	assert(!bt_uuid_cmp(gatt_db_attribute_get_type(
+				gatt_db_get_attribute(db, 5)), &expected));
+	gatt_db_unref(db);
+}
+static void stock_cache_control(void)
+{
+	uint8_t hash[16] = { 2 };
+	struct gatt_db *db = cache_database(hash);
+	struct cache_answer answer = { .hash = hash };
+	bt_uuid_t expected;
+	/* Invalid arguments never mutate the peer's database. */
+	assert(!bt_gatt_client_new_fresh(db, NULL, 23, 0));
+	cache_session(db, &answer, false);
+	assert(answer.success);
+	bt_uuid16_create(&expected, 0x2a37);
+	assert(!bt_uuid_cmp(gatt_db_attribute_get_type(
+				gatt_db_get_attribute(db, 5)), &expected));
+	gatt_db_unref(db);
+}
+
+struct observed { unsigned int calls; bool pending, success; uint8_t error; };
+static void observe(bool pending, bool success, int cause, uint8_t error, void *data)
+{
+	struct observed *observed = data;
+	(void) cause;
+	observed->calls++;
+	observed->pending = pending;
+	observed->success = success;
+	observed->error = error;
+}
+
+int main(void)
+{
+	struct bt_gatt_client client = { 0 };
+	struct observed observed = { 0 };
+	struct discovery_op operation = { .client = &client, .start = 1, .end = 9 };
+	struct bt_att_pdu_error_rsp error = { .ecode = BT_ATT_ERROR_DB_OUT_OF_SYNC };
+	uint8_t changed[] = { 1, 0, 9, 0 };
+	client.db = gatt_db_new();
+	client.clones = queue_new();
+	client.svc_chngd_queue = queue_new();
+	bt_gatt_client_set_ubm_discovery_observer(&client, observe, &observed);
+	initial_cache_test(false, false);
+	initial_cache_test(true, false);
+	initial_cache_test(false, true);
+	stock_cache_control();
+	if (getenv("UBM_TEST_CLONE_ONLY"))
+		goto clone_test;
+	/* A real queued indication invalidates now, before its rediscovery. */
+	client.in_svc_chngd = true;
+	ubm_discovery_begin(&client);
+	service_changed_cb(1, changed, sizeof(changed), &client);
+	service_changed_cb(1, changed, sizeof(changed), &client);
+	assert(observed.calls == 3 && observed.pending && !observed.success);
+	assert(client.ubm_refresh.pending == 3);
+	/* A fails; queued B cannot erase A's own error even if B succeeds. */
+	service_changed_complete(&operation, false, 0x05);
+	/* B's actual dispatch has no socket, and must settle failed, not hang. */
+	assert(!observed.pending && !observed.success && observed.error == 0x05);
+	assert(client.ubm_refresh.pending == 0);
+	assert(queue_isempty(client.svc_chngd_queue));
+	/* Hash-check admission fails synchronously without an ATT socket. */
+	client.in_svc_chngd = false;
+	gatt_client_db_sync_cb(&error, NULL, 0, 7, &client);
+	assert(!observed.pending && !observed.success);
+	assert(client.ubm_refresh.pending == 0);
+	assert(client.pending_retry_att_id == 0);
+	/* Positive queued completion is one cycle, never a ready interlude. */
+	ubm_discovery_begin(&client);
+	ubm_discovery_begin(&client);
+	ubm_discovery_finish(&client, true, 0);
+	assert(observed.pending && !observed.success);
+	ubm_discovery_finish(&client, true, 0);
+	assert(!observed.pending && observed.success);
+clone_test:
+	/* The real clone constructor replaces the shared ATT sync callback.
+	 * A clone's DB-out-of-sync must invalidate its owning database observer. */
+	{
+		int sockets[2];
+		struct bt_att *att;
+		struct bt_gatt_client *parent, *clone;
+		struct observed parent_observed = { 0 };
+		assert(!socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets));
+		att = bt_att_new(sockets[0], false);
+		assert(att);
+		parent = bt_gatt_client_ref(gatt_client_new(client.db, att, 0));
+		assert(parent);
+		parent->ready = true;
+		bt_gatt_client_set_ubm_discovery_observer(parent, observe, &parent_observed);
+		clone = bt_gatt_client_clone(parent);
+		assert(clone && clone->parent == parent);
+		gatt_client_db_sync_cb(&error, NULL, 0, 7, clone);
+		assert(parent_observed.calls > 0 && parent_observed.pending);
+		assert(parent->ubm_refresh.pending == 1);
+		assert(clone->ubm_refresh.pending == 0);
+		bt_gatt_client_unref(clone);
+		bt_gatt_client_unref(parent);
+		bt_att_unref(att);
+		close(sockets[0]);
+		close(sockets[1]);
+	}
+	bt_gatt_client_set_ubm_discovery_observer(&client, NULL, NULL);
+	queue_destroy(client.svc_chngd_queue, free);
+	queue_destroy(client.clones, NULL);
+	gatt_db_unref(client.db);
+	puts("Production refresh ingress/failure settlement: OK");
+	return 0;
+}
