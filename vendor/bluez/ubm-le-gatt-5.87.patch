+static bool ubm_gatt_init_allowed(struct btd_device *device)
+{
+	if (!btd_device_is_initiator(device) &&
+			(!btd_opts.reverse_discovery || !btd_opts.gatt_client)) {
+		if (!device->ubm_gatt.exhausted) {
+			device->ubm_gatt.status = UBM_GATT_UNSUPPORTED;
+			device->ubm_gatt.error = EOPNOTSUPP;
+			device->ubm_gatt.failure_stage = "policy";
+		}
+		ubm_emit(device);
+		return false;
+	}
+	return true;
+}
