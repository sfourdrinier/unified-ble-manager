+
+static void ubm_discovery_begin(struct bt_gatt_client *client)
+{
+	/* Clones share the parent's database and hold a reference to it. */
+	while (client->parent)
+		client = client->parent;
+	ubm_gatt_refresh_begin(&client->ubm_refresh);
+	if (client->ubm_observer)
+		client->ubm_observer(true, false,
+			client->ubm_refresh.exhausted ? EOVERFLOW : 0, 0,
+							client->ubm_data);
+}
+
+static void ubm_discovery_finish(struct bt_gatt_client *client,
+						bool success, uint8_t att_error)
+{
+	while (client->parent)
+		client = client->parent;
+	bool settled = ubm_gatt_refresh_finish(&client->ubm_refresh,
+							success, att_error);
+	if (client->ubm_observer)
+		client->ubm_observer(!settled,
+			settled && !client->ubm_refresh.failed,
+			client->ubm_refresh.exhausted ? EOVERFLOW :
+			client->ubm_refresh.failed ? EIO : 0,
+			client->ubm_refresh.att_error, client->ubm_data);
+}
