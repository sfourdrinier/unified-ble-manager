+struct ubm_projection {
+	struct btd_gatt_client *client;
+	struct queue *objects;
+	struct queue *seen;
+	unsigned int count;
+	bool complete;
+};
+
+static bool ubm_match_descriptor(const void *object, const void *attr)
+{
+	return ((const struct descriptor *) object)->attr == attr;
+}
+
+static bool ubm_match_characteristic(const void *object, const void *attr)
+{
+	return ((const struct characteristic *) object)->handle ==
+		gatt_db_attribute_get_handle((struct gatt_db_attribute *) attr);
+}
+
+static void ubm_check_descriptor(struct gatt_db_attribute *attr, void *data)
+{
+	struct ubm_projection *projection = data;
+	struct descriptor *descriptor;
+	projection->count++;
+	descriptor = queue_find(projection->objects, ubm_match_descriptor, attr);
+	if (!descriptor || descriptor->handle != gatt_db_attribute_get_handle(attr) ||
+		bt_uuid_cmp(&descriptor->uuid, gatt_db_attribute_get_type(attr)))
+		projection->complete = false;
+}
+
+static void ubm_check_characteristic(struct gatt_db_attribute *attr, void *data)
+{
+	struct ubm_projection *projection = data;
+	struct characteristic *chrc;
+	struct ubm_projection descriptors = { .complete = true };
+	uint16_t handle, value_handle, ext_props;
+	uint8_t props;
+	bt_uuid_t uuid;
+	projection->count++;
+	chrc = queue_find(projection->objects, ubm_match_characteristic, attr);
+	if (!chrc || !gatt_db_attribute_get_char_data(attr, &handle, &value_handle,
+						&props, &ext_props, &uuid) ||
+		chrc->service->client != projection->client || !chrc->attr ||
+		chrc->attr != gatt_db_get_attribute(projection->client->db, value_handle) ||
+		chrc->handle != handle || chrc->value_handle != value_handle ||
+		chrc->props != props || chrc->ext_props != ext_props ||
+		bt_uuid_cmp(&chrc->uuid, &uuid)) {
+		projection->complete = false;
+		return;
+	}
+	descriptors.objects = chrc->descs;
+	gatt_db_service_foreach_desc(attr, ubm_check_descriptor, &descriptors);
+	if (!descriptors.complete || descriptors.count != queue_length(chrc->descs))
+		projection->complete = false;
+}
+
+static void ubm_check_include(struct gatt_db_attribute *attr, void *data)
+{
+	struct ubm_projection *projection = data;
+	struct service *service;
+	uint16_t start, end;
+	if (!gatt_db_attribute_get_incl_data(attr, NULL, &start, &end)) {
+		projection->complete = false;
+		return;
+	}
+	service = queue_find(projection->objects, match_service_handle,
+							UINT_TO_PTR(start));
+	if (!service || service->end_handle != end) {
+		projection->complete = false;
+		return;
+	}
+	if (!queue_find(projection->seen, NULL, service)) {
+		queue_push_tail(projection->seen, service);
+		projection->count++;
+	}
+}
+
+static void ubm_check_service(struct gatt_db_attribute *attr, void *data)
+{
+	struct ubm_projection *projection = data;
+	struct service *service;
+	struct ubm_projection characteristics = { .complete = true };
+	struct ubm_projection includes = { .complete = true };
+	uint16_t start, end;
+	bool primary;
+	bt_uuid_t uuid;
+	projection->count++;
+	gatt_db_attribute_get_service_data(attr, &start, &end, &primary, &uuid);
+	service = queue_find(projection->objects, match_service_handle,
+							UINT_TO_PTR(start));
+	if (!service || service->client != projection->client ||
+		service->end_handle != end || service->primary != primary ||
+						bt_uuid_cmp(&service->uuid, &uuid)) {
+		projection->complete = false;
+		return;
+	}
+	characteristics.objects = service->chrcs;
+	characteristics.client = projection->client;
+	gatt_db_service_foreach_char(attr, ubm_check_characteristic, &characteristics);
+	if (!characteristics.complete ||
+			characteristics.count != queue_length(service->chrcs))
+		projection->complete = false;
+	includes.objects = service->incl_services;
+	includes.seen = queue_new();
+	gatt_db_service_foreach_incl(attr, ubm_check_include, &includes);
+	if (!includes.complete || includes.count != queue_length(service->incl_services))
+		projection->complete = false;
+	queue_destroy(includes.seen, NULL);
+}
+
+bool btd_gatt_client_projection_complete(struct btd_gatt_client *client)
+{
+	struct ubm_projection projection = { .complete = true };
+	if (!client || !client->ready || !client->db)
+		return false;
+	projection.client = client;
+	projection.objects = client->services;
+	gatt_db_foreach_service(client->db, NULL, ubm_check_service, &projection);
+	return projection.complete && projection.count == queue_length(client->services);
+}
