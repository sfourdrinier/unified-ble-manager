+/* Bonded CCC configuration survives ATT teardown; an acquired socket does
+ * not. Rearm only that per-ATT IO path, never the global StartNotify path. */
+static uint8_t restore_ccc_notify(struct btd_gatt_database *database,
+				struct bt_att *att, struct ccc_state *ccc)
+{
+	struct ccc_cb_data *cb;
+	struct external_chrc *chrc;
+	struct pending_op *op;
+	DBusMessageIter iter;
+	uint8_t ecode;
+
+	if (!ccc->value)
+		return 0;
+	cb = queue_find(database->ccc_callbacks, ccc_cb_match_handle,
+						UINT_TO_PTR(ccc->handle));
+	if (!cb || cb->callback != ccc_write_cb)
+		return 0;
+	chrc = cb->user_data;
+	if (!g_dbus_proxy_get_property(chrc->proxy, "NotifyAcquired", &iter))
+		return 0;
+	if (queue_find(chrc->notify_ios, match_client_att, att) ||
+		queue_find(chrc->pending_notifies, match_pending_notify_att, att))
+		return 0;
+	op = pending_ccc_new(att, chrc->ccc, ccc->value,
+						bt_att_get_link_type(att));
+	if (!op)
+		return BT_ATT_ERROR_UNLIKELY;
+	op->ccc_rearm = true;
+	op->ccc_existing = true;
+	ecode = ccc_write_cb(op, chrc);
+	if (ecode)
+		pending_op_free(op);
+	return ecode;
+}
+
+struct restore_notify_data {
+	struct btd_gatt_database *database;
+	struct bt_att *att;
+	bool renew_mtu;
+};
+
+static void restore_notify(void *data, void *user_data)
+{
+	struct restore_notify_data *restore = user_data;
+	struct ccc_state *ccc = data;
+	uint8_t ecode;
+	struct ccc_cb_data *cb;
+	struct external_chrc *chrc;
+	struct client_io *client;
+	DBusMessageIter iter;
+
+	/* AcquireNotify's MTU is immutable for the FD lifetime. A real ATT MTU
+	 * increase renews only this peer's IO, retaining the logical CCC count.
+	 * Default-MTU peers remain immediately usable without awaiting a request. */
+	if (restore->renew_mtu && ccc->value) {
+		cb = queue_find(restore->database->ccc_callbacks,
+				ccc_cb_match_handle, UINT_TO_PTR(ccc->handle));
+		if (!cb || cb->callback != ccc_write_cb)
+			return;
+		chrc = cb->user_data;
+		if (!g_dbus_proxy_get_property(chrc->proxy, "NotifyAcquired", &iter))
+			return;
+		queue_remove_all(chrc->pending_notifies, match_pending_notify_att,
+					restore->att, cancel_pending_notify);
+		client = queue_remove_if(chrc->notify_ios, match_client_att,
+								restore->att);
+		if (client)
+			client_io_free(client);
+	}
+
+	ecode = restore_ccc_notify(restore->database, restore->att, ccc);
+	if (ecode)
+		error("Failed to restore CCC 0x%04x notify IO: 0x%02x",
+						ccc->handle, ecode);
+}
