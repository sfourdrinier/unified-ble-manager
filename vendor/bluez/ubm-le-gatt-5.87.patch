+	assert(btd_ubm_le_operation_begin(&device, interest));
+	assert(g_slist_length(find_peer(&device)->interests) == 1);
+	send_call(client, "ReleaseLease", owned, &release);
+	receipt(&release, owned, 11, "lease-released-protected");
+	clear_call(&release);
+	assert(disconnect_calls == 1);
+	btd_ubm_le_operation_end_message(interest);
+	assert(!find_peer(&device)->interests);
+	btd_ubm_le_operation_end_message(interest);
+	assert(!find_peer(&device)->interests);
+	assert(btd_ubm_le_admit(&device, interest));
+	dbus_message_unref(interest);
+	send_call(client, "ReleaseLease", owned, &release);
+	receipt(&release, owned, 11, "lease-released-protected");
+	clear_call(&release);
+	assert(disconnect_calls == 1);
+	dbus_connection_close(external);
+	dbus_connection_unref(external);
+	int64_t until = g_get_monotonic_time() + G_TIME_SPAN_SECOND;
+	while (find_peer(&device)->interests && g_get_monotonic_time() < until) {
+		g_main_context_iteration(NULL, FALSE);
+		g_usleep(1000);
+	}
+	assert(!find_peer(&device)->interests);
+	/* An accepted MGMT disconnect that later refuses must settle and retry. */
+	send_call(client, "ReleaseLease", owned, &release);
+	while (disconnect_calls == 1) g_main_context_iteration(NULL, TRUE);
+	btd_ubm_le_disconnect_failed(&adapter, device_get_address(&device),
+		BDADDR_LE_PUBLIC, 11, "Rejected (0x0b)");
+	while (!release.reply) g_main_loop_run(loop);
+	assert(dbus_message_get_type(release.reply) == DBUS_MESSAGE_TYPE_ERROR);
+	assert(!find_peer(&device)->releasing);
+	assert(find_lease(&adapter, owned, dbus_bus_get_unique_name(client)));
+	clear_call(&release);
+	expected_disconnects = 3;
+	send_call(client, "ReleaseLease", owned, &release);
+	g_timeout_add(25, settle_disconnect, NULL);
+	assert(receipt(&release, owned, 11, "physical-released") == 2);
+	clear_call(&release);
+	send_call(client, "AckLease", owned, &replay);
+	await_call(&replay);
+	clear_call(&replay);
+	/* Sender death while Connect is accepted preserves its late physical effect. */
+	DBusConnection *dying = g_dbus_setup_private(DBUS_BUS_SESSION, NULL, &error);
+	assert(dying);
+	uint64_t late = reserve_token(dying);
+	send_call(dying, "ConnectLease", late, &connect);
+	while (!device.connecting) g_main_context_iteration(NULL, TRUE);
+	char *dead_sender = g_strdup(dbus_bus_get_unique_name(dying));
+	dbus_pending_call_cancel(connect.pending);
+	dbus_pending_call_unref(connect.pending);
+	memset(&connect, 0, sizeof(connect));
+	dbus_connection_close(dying);
+	dbus_connection_unref(dying);
+	until = g_get_monotonic_time() + G_TIME_SPAN_SECOND;
+	while (!find_lease(&adapter, late, dead_sender)->owner_dead &&
+			g_get_monotonic_time() < until)
+		g_main_context_iteration(NULL, FALSE);
+	assert(find_lease(&adapter, late, dead_sender)->owner_dead);
+	assert(find_lease(&adapter, late, dead_sender)->connecting);
+	device.generation = 12;
+	device.connecting = false;
+	btd_ubm_le_connected(&device, 12, true);
+	assert(disconnect_calls == 4 && find_peer(&device)->releasing);
+	device.generation = 0;
+	btd_ubm_le_lost(&device, 12, 2);
+	while (g_main_context_iteration(NULL, FALSE)) {}
+	assert(!find_lease(&adapter, late, dead_sender));
+	g_free(dead_sender);
+	/* Daemon auto-connect can raise a locally initiated link before this
+	 * lease exists. With no application holder, release still drops it. */
+	assert(!find_peer(&device));
+	device.generation = 21;
+	device.initiator = true;
+	unsigned int connects_before = connect_calls;
+	expected_disconnects = disconnect_calls + 1;
+	uint64_t adopted = reserve_token(client);
+	assert(find_peer(&device)->borrowed);
+	assert(!find_peer(&device)->born_exclusive);
+	assert(!find_peer(&device)->unknown_interest);
+	assert(!find_peer(&device)->interests);
+	send_call(client, "ConnectLease", adopted, &connect);
+	await_call(&connect);
+	clear_call(&connect);
+	assert(connect_calls == connects_before);
+	settle_generation = 21;
+	send_call(client, "ReleaseLease", adopted, &release);
+	g_timeout_add(25, settle_disconnect, NULL);
+	assert(receipt(&release, adopted, 21, "physical-released") == 2);
+	clear_call(&release);
+	assert(disconnect_calls == expected_disconnects);
+	puts("production lease handlers: nonce recovery fences, interleaved lifetime ACKs, accepted cancellation/sender death, protected/exclusive release, asynchronous refusal retry and exact generation passed");
+	return 0;
+}
--- a/unit/test-ubm-refresh.c
+++ b/unit/test-ubm-refresh.c
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+/* Production invalidation/completion paths with no ATT socket or radio. */
+#include "src/shared/gatt-client.c"
+#include <stdio.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <glib.h>
+
+struct cache_answer {
+	bool done, success, refuse;
+	unsigned int primary;
+	uint8_t *hash;
+};
+static void cache_ready(bool success, uint8_t error, void *data)
+{
+	struct cache_answer *answer = data;
+	(void) error;
+	answer->done = true;
+	answer->success = success;
+}
+static gboolean cache_respond(GIOChannel *io, GIOCondition condition, void *data)
+{
+	struct cache_answer *answer = data;
+	uint8_t request[64], response[32];
+	int fd = g_io_channel_unix_get_fd(io);
+	ssize_t length = read(fd, request, sizeof(request));
+	uint16_t start, type;
+	size_t size = 5;
+	(void) condition;
+	assert(length >= 5);
+	start = get_le16(request + 1);
+	type = length >= 7 ? get_le16(request + 5) : 0;
+	response[0] = BT_ATT_OP_ERROR_RSP;
+	response[1] = request[0];
+	put_le16(start, response + 2);
+	response[4] = BT_ATT_ERROR_ATTRIBUTE_NOT_FOUND;
+	if (request[0] == BT_ATT_OP_READ_BY_GRP_TYPE_REQ && type == 0x2800) {
+		answer->primary++;
+		if (answer->refuse) {
+			/* A malformed accepted response settles with no ATT error. */
+			response[0] = BT_ATT_OP_READ_BY_GRP_TYPE_RSP;
+			response[1] = 6;
+			size = 2;
+		} else if (start == 1) {
+			uint8_t service[] = { 0x11, 6, 1, 0, 8, 0, 1, 0x18 };
+			memcpy(response, service, sizeof(service));
+			size = sizeof(service);
+		}
+	} else if (request[0] == BT_ATT_OP_READ_BY_TYPE_REQ && type == 0x2b2a) {
+		response[0] = BT_ATT_OP_READ_BY_TYPE_RSP;
+		response[1] = 18;
+		put_le16(3, response + 2);
+		memcpy(response + 4, answer->hash, 16);
+		size = 20;
+	} else if (request[0] == BT_ATT_OP_READ_BY_TYPE_REQ && type == 0x2803 && start <= 4) {
+		uint8_t characteristics[] = { 0x09, 7, 2, 0, 2, 3, 0, 0x2a, 0x2b,
+						4, 0, 2, 5, 0, 0x38, 0x2a };
+		memcpy(response, characteristics, sizeof(characteristics));
+		size = sizeof(characteristics);
+	}
+	assert(write(fd, response, size) == (ssize_t) size);
+	return G_SOURCE_CONTINUE;
+}
+static void cache_written(struct gatt_db_attribute *attr, int error, void *data)
+{
+	(void) attr;
+	(void) data;
+	assert(!error);
+}
+static struct gatt_db *cache_database(uint8_t *hash)
+{
+	struct gatt_db *db = gatt_db_new();
+	struct gatt_db_attribute *service, *value;
+	bt_uuid_t uuid;
+	bt_uuid16_create(&uuid, 0x1801);
+	service = gatt_db_add_service(db, &uuid, true, 8);
+	assert(service);
+	bt_uuid16_create(&uuid, GATT_CHARAC_DB_HASH);
+	value = gatt_db_service_add_characteristic(service, &uuid,
+		BT_ATT_PERM_READ, BT_GATT_CHRC_PROP_READ,
+		NULL, NULL, NULL);
+	assert(value);
+	assert(gatt_db_attribute_write(value, 0, hash, 16, 0, NULL,
+						cache_written, NULL));
+	bt_uuid16_create(&uuid, 0x2a37);
+	assert(gatt_db_service_add_characteristic(service, &uuid,
+		BT_ATT_PERM_READ, BT_GATT_CHRC_PROP_READ, NULL, NULL, NULL));
+	gatt_db_service_set_active(service, true);
+	return db;
+}
+static void cache_session(struct gatt_db *db, struct cache_answer *answer,
+							bool fresh)
+{
+	int sockets[2];
+	struct bt_att *client_att;
+	struct bt_gatt_client *client;
+	GIOChannel *io;
+	guint watch;
+	assert(!socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets));
+	client_att = bt_att_new(sockets[0], false);
+	assert(client_att);
+	io = g_io_channel_unix_new(sockets[1]);
+	watch = g_io_add_watch(io, G_IO_IN, cache_respond, answer);
+	assert(watch);
+	client = fresh ? bt_gatt_client_new_fresh(db, client_att, 23, 0) :
+				bt_gatt_client_new(db, client_att, 23, 0);
+	assert(client);
+	assert(bt_gatt_client_ready_register(client, cache_ready, answer, NULL));
+	/* The alarm is a failure-only watchdog, never a readiness verdict. */
+	alarm(10);
+	while (!answer->done)
+		g_main_context_iteration(NULL, true);
+	alarm(0);
+	bt_gatt_client_unref(client);
+	g_source_remove(watch);
+	g_io_channel_unref(io);
+	bt_att_unref(client_att);
+	close(sockets[0]);
+	close(sockets[1]);
+}
+static void initial_cache_test(bool interrupted, bool matching)
+{
+	uint8_t old_hash[16] = { 1 }, new_hash[16] = { 2 };
+	if (matching)
+		old_hash[0] = new_hash[0];
+	struct gatt_db *db = cache_database(old_hash);
+	struct cache_answer answer = { .refuse = interrupted, .hash = new_hash };
+	struct gatt_db_attribute *hash;
+	const uint8_t *stored = NULL;
+	bt_uuid_t expected;
+	cache_session(db, &answer, true);
+	if (interrupted) {
+		assert(!answer.success && answer.primary > 0);
+		hash = gatt_db_get_attribute(db, 3);
+		if (hash)
+			gatt_db_attribute_read(hash, 0, 0, NULL,
+						db_hash_read_value_cb, &stored);
+		assert(!stored || memcmp(stored, new_hash, 16));
+		answer = (struct cache_answer) { .hash = new_hash };
+		cache_session(db, &answer, true);
+		assert(answer.primary > 0);
+	}
+	assert(answer.success);
+	bt_uuid16_create(&expected, 0x2a38);
+	assert(gatt_db_get_attribute(db, 5));
+	assert(!bt_uuid_cmp(gatt_db_attribute_get_type(
+				gatt_db_get_attribute(db, 5)), &expected));
+	gatt_db_unref(db);
+}
+static void stock_cache_control(void)
+{
+	uint8_t hash[16] = { 2 };
+	struct gatt_db *db = cache_database(hash);
+	struct cache_answer answer = { .hash = hash };
+	bt_uuid_t expected;
+	/* Invalid arguments never mutate the peer's database. */
+	assert(!bt_gatt_client_new_fresh(db, NULL, 23, 0));
+	cache_session(db, &answer, false);
+	assert(answer.success);
+	bt_uuid16_create(&expected, 0x2a37);
+	assert(!bt_uuid_cmp(gatt_db_attribute_get_type(
+				gatt_db_get_attribute(db, 5)), &expected));
+	gatt_db_unref(db);
+}
+
+struct observed { unsigned int calls; bool pending, success; uint8_t error; };
+static void observe(bool pending, bool success, int cause, uint8_t error, void *data)
+{
+	struct observed *observed = data;
+	(void) cause;
+	observed->calls++;
+	observed->pending = pending;
+	observed->success = success;
+	observed->error = error;
+}
+
+static void ready_count(bool success, uint8_t error, void *data)
+{
+	unsigned int *count = data;
+	(void) success;
+	(void) error;
+	(*count)++;
+}
+static void ready_removed(void *data)
+{
+	unsigned int *count = data;
+	(*count) += 10;
+}
+static void ready_registration_lifetime(void)
+{
+	struct bt_gatt_client client = { .ref_count = 1 };
+	unsigned int removed = 0, retained = 0;
+	client.ready_cbs = queue_new();
+	client.clones = queue_new();
+	unsigned int a = bt_gatt_client_ready_register(&client, ready_count,
+						&removed, ready_removed);
+	unsigned int b = bt_gatt_client_ready_register(&client, ready_count,
+						&retained, ready_removed);
+	assert(a && b && a != b);
+	assert(!bt_gatt_client_ready_unregister(&client, 0));
+	/* On 64-bit hosts these actual heap entries live above UINT_MAX. */
+	assert(bt_gatt_client_ready_unregister(&client, a));
+	assert(removed == 10);
+	assert(!bt_gatt_client_ready_unregister(&client, a));
+	notify_client_ready(&client, false, 0);
+	assert(removed == 10 && retained == 11);
+	client.ready = true;
+	unsigned int cached = 0;
+	unsigned int cached_id = bt_gatt_client_ready_register(&client,
+					ready_count, &cached, ready_removed);
+	/* Registration is queued, not a synchronous callback even when ready. */
+	assert(cached_id && cached == 0);
+	assert(bt_gatt_client_ready_unregister(&client, cached_id));
+	assert(cached == 10);
+	client.last_ready_id = UINT_MAX;
+	assert(!bt_gatt_client_ready_register(&client, ready_count,
+						&retained, ready_removed));
+	assert(retained == 11);
+	queue_destroy(client.ready_cbs, ready_destroy);
+	queue_destroy(client.clones, NULL);
+}
+struct reentrant_ready {
+	struct bt_gatt_client *client;
+	unsigned int id;
+	bool in_callback, destroyed;
+};
+static void ready_reentrant_destroy(void *data)
+{
+	struct reentrant_ready *ready = data;
+	assert(!ready->in_callback);
+	ready->destroyed = true;
+}
+static void ready_reentrant(bool success, uint8_t error, void *data)
+{
+	struct reentrant_ready *ready = data;
+	(void) success;
+	(void) error;
+	ready->in_callback = true;
+	/* Cleanup can unregister the current ready callback synchronously. */
+	bt_gatt_client_ready_unregister(ready->client, ready->id);
+	assert(!ready->destroyed);
+	ready->in_callback = false;
+}
+static void ready_reentrant_retirement(void)
+{
+	struct bt_gatt_client client = { .ref_count = 1 };
+	struct reentrant_ready ready = { .client = &client };
+	client.ready_cbs = queue_new();
+	client.clones = queue_new();
+	ready.id = bt_gatt_client_ready_register(&client, ready_reentrant,
+					&ready, ready_reentrant_destroy);
+	assert(ready.id);
+	notify_client_ready(&client, false, 0);
+	assert(ready.destroyed);
+	queue_destroy(client.ready_cbs, ready_destroy);
+	queue_destroy(client.clones, NULL);
+}
+int main(void)
+{
+	ready_registration_lifetime();
+	ready_reentrant_retirement();
+	struct bt_gatt_client client = { 0 };
+	struct observed observed = { 0 };
+	struct discovery_op operation = { .client = &client, .start = 1, .end = 9 };
+	struct bt_att_pdu_error_rsp error = { .ecode = BT_ATT_ERROR_DB_OUT_OF_SYNC };
+	uint8_t changed[] = { 1, 0, 9, 0 };
+	client.db = gatt_db_new();
+	client.clones = queue_new();
+	client.svc_chngd_queue = queue_new();
+	bt_gatt_client_set_ubm_discovery_observer(&client, observe, &observed);
+	initial_cache_test(false, false);
+	initial_cache_test(true, false);
+	initial_cache_test(false, true);
+	stock_cache_control();
+	if (getenv("UBM_TEST_CLONE_ONLY"))
+		goto clone_test;
+	/* A real queued indication invalidates now, before its rediscovery. */
+	client.in_svc_chngd = true;
+	ubm_discovery_begin(&client);
+	service_changed_cb(1, changed, sizeof(changed), &client);
+	service_changed_cb(1, changed, sizeof(changed), &client);
+	assert(observed.calls == 3 && observed.pending && !observed.success);
+	assert(client.ubm_refresh.pending == 3);
+	/* A fails; queued B cannot erase A's own error even if B succeeds. */
+	service_changed_complete(&operation, false, 0x05);
+	/* B's actual dispatch has no socket, and must settle failed, not hang. */
+	assert(!observed.pending && !observed.success && observed.error == 0x05);
+	assert(client.ubm_refresh.pending == 0);
+	assert(queue_isempty(client.svc_chngd_queue));
+	/* Hash-check admission fails synchronously without an ATT socket. */
+	client.in_svc_chngd = false;
+	gatt_client_db_sync_cb(&error, NULL, 0, 7, &client);
+	assert(!observed.pending && !observed.success);
+	assert(client.ubm_refresh.pending == 0);
+	assert(client.pending_retry_att_id == 0);
+	/* Positive queued completion is one cycle, never a ready interlude. */
+	ubm_discovery_begin(&client);
+	ubm_discovery_begin(&client);
+	ubm_discovery_finish(&client, true, 0);
+	assert(observed.pending && !observed.success);
+	ubm_discovery_finish(&client, true, 0);
+	assert(!observed.pending && observed.success);
+clone_test:
+	/* The real clone constructor replaces the shared ATT sync callback.
+	 * A clone's DB-out-of-sync must invalidate its owning database observer. */
+	{
+		int sockets[2];
+		struct bt_att *att;
+		struct bt_gatt_client *parent, *clone;
+		struct observed parent_observed = { 0 };
+		assert(!socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets));
+		att = bt_att_new(sockets[0], false);
+		assert(att);
+		parent = bt_gatt_client_ref(gatt_client_new(client.db, att, 0));
+		assert(parent);
+		parent->ready = true;
+		bt_gatt_client_set_ubm_discovery_observer(parent, observe, &parent_observed);
+		clone = bt_gatt_client_clone(parent);
+		assert(clone && clone->parent == parent);
+		gatt_client_db_sync_cb(&error, NULL, 0, 7, clone);
+		assert(parent_observed.calls > 0 && parent_observed.pending);
+		assert(parent->ubm_refresh.pending == 1);
+		assert(clone->ubm_refresh.pending == 0);
+		bt_gatt_client_unref(clone);
+		bt_gatt_client_unref(parent);
+		bt_att_unref(att);
+		close(sockets[0]);
+		close(sockets[1]);
+	}
+	bt_gatt_client_set_ubm_discovery_observer(&client, NULL, NULL);
+	queue_destroy(client.svc_chngd_queue, free);
+	queue_destroy(client.clones, NULL);
+	gatt_db_unref(client.db);
+	puts("Production refresh ingress/failure settlement: OK");
+	return 0;
+}
--- a/unit/test-ubm-scan-filter.c
+++ b/unit/test-ubm-scan-filter.c
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Exercise the actual daemon advertisement filter without radio or D-Bus. */
+#include "src/adapter.c"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void)
+{
+	const char *heart_rate = "0000180d-0000-1000-8000-00805f9b34fb";
+	const char *battery = "0000180f-0000-1000-8000-00805f9b34fb";
+	struct discovery_filter filter = {
+		.rssi = DISTANCE_VAL_INVALID,
+		.pathloss = DISTANCE_VAL_INVALID,
+	};
+	struct discovery_client client = { .discovery_filter = &filter };
+	struct eir_data eir = { .services = queue_new(), .tx_power = 127 };
+	GSList *clients = g_slist_append(NULL, &client);
+
+	filter.uuids = g_slist_append(NULL, (void *) heart_rate);
+	assert(queue_push_tail(eir.services, (void *) battery));
+	assert(!is_filter_match(clients, &eir, -73));
+	assert(queue_push_tail(eir.services, (void *) heart_rate));
+	assert(is_filter_match(clients, &eir, -73));
+	queue_remove_all(eir.services, NULL, NULL, NULL);
+	assert(!is_filter_match(clients, &eir, -73));
+	g_slist_free(filter.uuids);
+	filter.uuids = NULL;
+	assert(is_filter_match(clients, &eir, -73));
+	queue_destroy(eir.services, NULL);
+	g_slist_free(clients);
+	puts("actual daemon UUID filter matching/nonmatching/empty passed");
+	return 0;
+}
