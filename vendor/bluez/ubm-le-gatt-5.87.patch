+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Real daemon tables/handlers on private D-Bus; kernel/device boundary doubles. */
+#include "src/ubm-le-lease.c"
+#include <assert.h>
+#include <stdio.h>
+
+struct btd_adapter { int identity; };
+struct btd_device { uint64_t generation; bool connecting; bool initiator; int refs; };
+static struct btd_adapter adapter;
+static struct btd_device device;
+static DBusConnection *server;
+static unsigned int connect_calls, disconnect_calls, quiesce_calls;
+static int connect_result, disconnect_result;
+static bool device_visible = true;
+static uint64_t settle_generation = 9;
+static unsigned int expected_disconnects = 1;
+static GMainLoop *loop;
+static unsigned int availability_reports;
+static DBusHandlerResult availability_report(DBusConnection *conn,
+					DBusMessage *message, void *data)
+{
+	const char *path;
+	uint64_t sequence;
+	(void) conn;
+	(void) data;
+	if (!dbus_message_is_signal(message, AUTHORITY, "LeAdvertisement"))
+		return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+	assert(dbus_message_get_args(message, NULL, DBUS_TYPE_OBJECT_PATH, &path,
+		DBUS_TYPE_UINT64, &sequence, DBUS_TYPE_INVALID));
+	assert(!strcmp(path, "/org/bluez/hci0/dev_01_02_03_04_05_06"));
+	assert(sequence == availability_reports + 1);
+	availability_reports++;
+	return DBUS_HANDLER_RESULT_HANDLED;
+}
+
+DBusConnection *btd_get_dbus_connection(void) { return server; }
+void btd_error(uint16_t index, const char *format, ...)
+{ (void) index; (void) format; assert(!"unexpected native report emission failure"); }
+struct btd_device *btd_device_ref(struct btd_device *dev) { dev->refs++; return dev; }
+void btd_device_unref(struct btd_device *dev) { dev->refs--; }
+struct btd_adapter *device_get_adapter(struct btd_device *dev)
+{ (void) dev; return &adapter; }
+const char *adapter_get_path(struct btd_adapter *value)
+{ assert(value == &adapter); return "/org/bluez/hci0"; }
+const char *device_get_path(const struct btd_device *dev)
+{ assert(dev == &device); return "/org/bluez/hci0/dev_01_02_03_04_05_06"; }
+struct btd_device *btd_adapter_find_device_by_path(struct btd_adapter *value,
+						const char *path)
+{ return device_visible && value == &adapter && !strcmp(path, device_get_path(&device)) ? &device : NULL; }
+uint64_t btd_device_ubm_le_generation(struct btd_device *dev)
+{ return dev->generation; }
+void btd_device_ubm_le_generation_lost(struct btd_device *dev, uint64_t generation)
+{ if (dev->generation == generation) dev->generation = 0; }
+bool device_is_connecting(struct btd_device *dev) { return dev->connecting; }
+const bdaddr_t *device_get_address(struct btd_device *dev)
+{ static bdaddr_t address; assert(dev == &device); return &address; }
+uint8_t device_get_le_address_type(struct btd_device *dev)
+{ assert(dev == &device); return BDADDR_LE_PUBLIC; }
+int device_connect_le(struct btd_device *dev)
+{
+	assert(dev == &device);
+	assert(btd_ubm_le_internal_activity(dev));
+	connect_calls++;
+	dev->connecting = connect_result == 0;
+	return connect_result;
+}
+void btd_device_quiesce_untrusted_auto_connect(struct btd_device *dev)
+{
+	assert(dev == &device);
+	quiesce_calls++;
+}
+bool btd_device_is_initiator(struct btd_device *dev)
+{
+	assert(dev == &device);
+	return dev->initiator;
+}
+int btd_adapter_disconnect_device(struct btd_adapter *value,
+					const bdaddr_t *address, uint8_t type)
+{
+	assert(value == &adapter && address == device_get_address(&device));
+	assert(type == BDADDR_LE_PUBLIC);
+	assert(quiesce_calls == disconnect_calls + 1);
+	disconnect_calls++;
+	return disconnect_result;
+}
+
+struct call { DBusPendingCall *pending; DBusMessage *reply; };
+static void replied(DBusPendingCall *pending, void *data)
+{
+	struct call *call = data;
+	call->reply = dbus_pending_call_steal_reply(pending);
+	g_main_loop_quit(loop);
+}
+static void send_call(DBusConnection *client, const char *method,
+			uint64_t token, struct call *call)
+{
+	DBusMessage *request = dbus_message_new_method_call("org.ubm.Test",
+				adapter_get_path(&adapter),
+				(!strcmp(method, "GetContract") || !strcmp(method, "GetLeAvailability")) ? AUTHORITY : LEASE, method);
+	const char *path = device_get_path(&device);
+	if (!strcmp(method, "ReserveLease"))
+		dbus_message_append_args(request, DBUS_TYPE_OBJECT_PATH, &path,
+					DBUS_TYPE_UINT64, &token,
+							DBUS_TYPE_INVALID);
+	else if (strcmp(method, "GetContract") && strcmp(method, "GetLeAvailability"))
+		dbus_message_append_args(request, DBUS_TYPE_UINT64, &token,
+							DBUS_TYPE_INVALID);
+	assert(dbus_connection_send_with_reply(client, request, &call->pending, 5000));
+	assert(dbus_pending_call_set_notify(call->pending, replied, call, NULL));
+	dbus_message_unref(request);
+}
+static void await_call(struct call *call)
+{
+	while (!call->reply)
+		g_main_loop_run(loop);
+	assert(dbus_message_get_type(call->reply) == DBUS_MESSAGE_TYPE_METHOD_RETURN);
+}
+static void clear_call(struct call *call)
+{
+	dbus_message_unref(call->reply);
+	dbus_pending_call_unref(call->pending);
+	memset(call, 0, sizeof(*call));
+}
+static uint64_t reserve_token(DBusConnection *client)
+{
+	struct call call = { 0 };
+	uint64_t token;
+	static GHashTable *identities;
+	const char *sender = dbus_bus_get_unique_name(client);
+	if (!identities)
+		identities = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, g_free);
+	uint64_t *identity = g_hash_table_lookup(identities, sender);
+	if (!identity) {
+		identity = g_new0(uint64_t, 1);
+		g_hash_table_insert(identities, g_strdup(sender), identity);
+	}
+	send_call(client, "ReserveLease", ++*identity, &call);
+	await_call(&call);
+	assert(dbus_message_get_args(call.reply, NULL, DBUS_TYPE_UINT64,
+					&token, DBUS_TYPE_INVALID));
+	clear_call(&call);
+	assert(token != 0);
+	return token;
+}
+static uint8_t receipt(struct call *call, uint64_t token, uint64_t generation,
+						const char *expected)
+{
+	uint32_t version;
+	uint64_t returned_token, returned_generation;
+	const char *scope;
+	await_call(call);
+	assert(!strcmp(dbus_message_get_signature(call->reply), "uttsby"));
+	dbus_bool_t has_reason;
+	uint8_t reason;
+	assert(dbus_message_get_args(call->reply, NULL,
+		DBUS_TYPE_UINT32, &version, DBUS_TYPE_UINT64, &returned_token,
+		DBUS_TYPE_UINT64, &returned_generation, DBUS_TYPE_STRING, &scope,
+		DBUS_TYPE_BOOLEAN, &has_reason, DBUS_TYPE_BYTE, &reason,
+		DBUS_TYPE_INVALID));
+	assert(version == 2 && token == returned_token && generation == returned_generation);
+	assert(!strcmp(expected, scope));
+	if (!strcmp(scope, "physical-released")) {
+		assert(has_reason && (reason == 2 || reason == 3));
+	} else {
+		assert(!has_reason && reason == 0);
+	}
+	return reason;
+}
+static gboolean settle_connect(void *data)
+{
+	(void) data;
+	device.generation = settle_generation;
+	device.connecting = false;
+	btd_ubm_le_connected(&device, settle_generation, true);
+	return G_SOURCE_REMOVE;
+}
+static gboolean settle_disconnect(void *data)
+{
+	(void) data;
+	assert(disconnect_calls == expected_disconnects);
+	assert(find_peer(&device)->releasing);
+	assert(!btd_ubm_le_admit(&device, NULL));
+	device.generation = 0;
+	btd_ubm_le_lost(&device, settle_generation, 2);
+	return G_SOURCE_REMOVE;
+}
+int main(void)
+{
+	DBusError error = DBUS_ERROR_INIT;
+	DBusConnection *client;
+	struct call connect = { 0 }, release = { 0 }, replay = { 0 };
+	uint64_t token, second;
+	server = g_dbus_setup_bus(DBUS_BUS_SESSION, "org.ubm.Test", &error);
+	assert(server);
+	client = g_dbus_setup_private(DBUS_BUS_SESSION, NULL, &error);
+	assert(client);
+	loop = g_main_loop_new(NULL, FALSE);
