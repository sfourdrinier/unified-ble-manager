+gboolean bt_io_get(GIOChannel *io, GError **err, BtIOOption first, ...)
+{
+	va_list args;
+	BtIOOption option = first;
+	va_start(args, first);
+	while (option != BT_IO_OPT_INVALID) {
+		void *out = va_arg(args, void *);
+		if (option == BT_IO_OPT_DEST_BDADDR) bacpy(out, &peer);
+		else if (option == BT_IO_OPT_SOURCE_BDADDR) memset(out, 0, 6);
+		else if (option == BT_IO_OPT_DEST_TYPE) *(uint8_t *) out = BDADDR_LE_PUBLIC;
+		else assert(false);
+		option = va_arg(args, int);
+	}
+	va_end(args);
+	return true;
