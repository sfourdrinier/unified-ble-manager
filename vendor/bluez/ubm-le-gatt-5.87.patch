+#include <string.h>
+#include <glib.h>
+#include <dbus/dbus.h>
+#include "bluetooth/bluetooth.h"
+#include "gdbus/gdbus.h"
+#include "adapter.h"
+#include "device.h"
+#include "dbus-common.h"
+#include "error.h"
+#include "log.h"
+#include "ubm-le-lease.h"
+
+#define AUTHORITY "org.unifiedblemanager.LinuxAuthority1"
+#define LEASE "org.unifiedblemanager.LELease1"
+/* Native MGMT report order within this daemon epoch, not device cache age. */
+static uint64_t availability_sequence;
+
+void btd_ubm_le_advertisement(struct btd_adapter *adapter,
+		struct btd_device *device, uint8_t type, bool connectable)
+{
+	const char *path;
+	if (type == BDADDR_BREDR || !connectable ||
+			availability_sequence == UINT64_MAX)
+		return;
+	path = device_get_path(device);
+	availability_sequence++;
+	if (!g_dbus_emit_signal(btd_get_dbus_connection(), adapter_get_path(adapter),
+		AUTHORITY, "LeAdvertisement", DBUS_TYPE_OBJECT_PATH, &path,
+		DBUS_TYPE_UINT64, &availability_sequence, DBUS_TYPE_INVALID))
+		error("UBM LE availability report could not be emitted for %s", path);
+}
+
+static DBusMessage *get_le_availability(DBusConnection *conn,
+				DBusMessage *message, void *data)
+{
+	uint32_t version = 1;
+	(void) conn;
+	(void) data;
+	if (availability_sequence == UINT64_MAX)
+		return btd_error_failed(message, "LE availability sequence exhausted");
+	return g_dbus_create_reply(message, DBUS_TYPE_UINT32, &version,
+		DBUS_TYPE_UINT64, &availability_sequence, DBUS_TYPE_INVALID);
+}
+/* Never evict a retained cleanup identity to admit a newer resource. */
+#define MAX_TOKENS 1024
+#define MAX_INTERESTS 128
+#define MAX_FENCE_RANGES 1024
+
+struct interval { uint64_t first, last; };
+struct history {
+	struct btd_adapter *adapter;
+	char *sender;
+	guint watch;
+	GArray *reservations;
+	GArray *tokens;
+	uint32_t token_namespace;
+	uint32_t token_serial;
+};
+static GSList *histories;
+
+struct interest {
+	char *sender;
+	guint watch;
+	unsigned int inflight;
+	bool held;
+};
+struct operation {
+	DBusMessage *message;
+	struct interest *interest;
+};
+static GSList *operations;
+struct peer {
+	struct btd_device *device;
+	struct btd_adapter *adapter;
+	uint64_t generation;
+	bool born_exclusive;
+	bool borrowed;
+	bool unknown_interest;
+	bool releasing;
+	bool withdrawn;
+	GSList *interests;
+};
+struct lease {
+	uint64_t token;
+	uint64_t reservation_id;
+	struct btd_adapter *adapter;
+	struct peer *peer;
+	char *path;
+	char *sender;
+	guint watch;
+	bool connecting;
+	bool accepted;
+	bool released;
+	bool owner_dead;
+	uint64_t generation;
+	dbus_bool_t has_disconnect_reason;
+	uint8_t disconnect_reason;
+	const char *receipt;
+	DBusMessage *connect;
+	GSList *releases;
+};
+static GSList *peers;
+static GSList *leases;
+static uint32_t token_namespace_serial;
+/* Synchronous scoped admission; no callbacks run inside device_connect_le. */
+static struct btd_device *own_connect;
+
+static void history_dead(DBusConnection *conn, void *data)
+{
+	struct history *history = data;
+	(void) conn;
+	histories = g_slist_remove(histories, history);
+	g_array_unref(history->reservations);
+	g_array_free(history->tokens, true);
+	g_free(history->sender);
+	g_free(history);
+}
+
+static struct history *get_history(struct btd_adapter *adapter,
+						const char *sender)
+{
+	GSList *l;
+	struct history *history;
+	GArray *sender_reservations = NULL;
+	for (l = histories; l; l = l->next) {
+		history = l->data;
+		if (history->adapter == adapter && !strcmp(history->sender, sender))
+			return history;
+		if (!strcmp(history->sender, sender))
+			sender_reservations = history->reservations;
+	}
+	if (token_namespace_serial == UINT32_MAX)
+		return NULL;
+	history = g_new0(struct history, 1);
+	history->adapter = adapter;
+	history->sender = g_strdup(sender);
+	/* Native nonces belong to the D-Bus sender, not one of its adapters. */
+	history->reservations = sender_reservations ? g_array_ref(sender_reservations) :
+			g_array_new(false, false, sizeof(struct interval));
+	history->tokens = g_array_new(false, false, sizeof(struct interval));
+	/* Globally nonrecycled identities, contiguous within this exact owner. */
+	history->token_namespace = ++token_namespace_serial;
+	history->watch = g_dbus_add_disconnect_watch(btd_get_dbus_connection(),
+					sender, history_dead, history, NULL);
+	if (!history->watch) {
+		history_dead(NULL, history);
+		return NULL;
+	}
+	histories = g_slist_prepend(histories, history);
+	return history;
+}
+
+static bool contains(GArray *ranges, uint64_t identity)
+{
+	guint i;
+	for (i = 0; i < ranges->len; i++) {
+		struct interval range = g_array_index(ranges, struct interval, i);
+		if (identity >= range.first && identity <= range.last)
+			return true;
+	}
+	return false;
+}
+
+static int interval_order(const void *a, const void *b)
+{
+	const struct interval *left = a, *right = b;
+	return (left->first > right->first) - (left->first < right->first);
+}
+
+static bool add_fence(GArray *ranges, uint64_t identity)
+{
+	GArray *ordered, *merged;
+	struct interval range = { identity, identity };
+	guint i;
+	if (!identity)
+		return false;
+	if (contains(ranges, identity))
+		return true;
+	ordered = g_array_sized_new(false, false, sizeof(range), ranges->len + 1);
+	g_array_append_vals(ordered, ranges->data, ranges->len);
+	g_array_append_val(ordered, range);
+	g_array_sort(ordered, interval_order);
+	merged = g_array_sized_new(false, false, sizeof(range), ordered->len);
+	for (i = 0; i < ordered->len; i++) {
+		range = g_array_index(ordered, struct interval, i);
+		if (merged->len) {
+			struct interval *last = &g_array_index(merged, struct interval,
+							merged->len - 1);
+			if (range.first <= last->last ||
+				(last->last != UINT64_MAX && range.first == last->last + 1)) {
+				if (range.last > last->last)
+					last->last = range.last;
+				continue;
+			}
+		}
+		g_array_append_val(merged, range);
+	}
+	g_array_free(ordered, true);
+	if (merged->len > MAX_FENCE_RANGES) {
+		g_array_free(merged, true);
+		return false;
+	}
+	g_array_set_size(ranges, 0);
+	g_array_append_vals(ranges, merged->data, merged->len);
+	g_array_free(merged, true);
+	return true;
+}
+
+static void free_lease(struct lease *lease)
+{
+	if (lease->watch)
+		g_dbus_remove_watch(btd_get_dbus_connection(), lease->watch);
+	leases = g_slist_remove(leases, lease);
+	g_free(lease->sender);
+	g_free(lease->path);
+	g_free(lease);
+}
+
+static gboolean collect_dead(void *data)
+{
+	GSList *l = leases;
+	(void) data;
+	while (l) {
+		struct lease *lease = l->data;
+		l = l->next;
+		if (lease->owner_dead && !lease->connecting &&
+				(!lease->peer || (lease->receipt &&
+				 (!strcmp(lease->receipt, "physical-released") ||
+				  !strcmp(lease->receipt, "reservation-released")))))
+			free_lease(lease);
+	}
+	l = peers;
+	while (l) {
+		struct peer *peer = l->data;
+		GSList *owned;
+		bool retained = peer->interests != NULL;
+		l = l->next;
+		for (owned = leases; owned && !retained; owned = owned->next)
+			retained = ((struct lease *) owned->data)->peer == peer;
+		if (!retained) {
+			peers = g_slist_remove(peers, peer);
+			btd_device_unref(peer->device);
+			g_free(peer);
+		}
+	}
+	return G_SOURCE_REMOVE;
+}
+
+static struct peer *find_peer(struct btd_device *device)
+{
+	GSList *l;
+	for (l = peers; l; l = l->next) {
+		struct peer *peer = l->data;
+		if (peer->device == device)
+			return peer;
+	}
+	return NULL;
+}
+
+static struct peer *get_peer(struct btd_device *device)
+{
+	struct peer *peer = find_peer(device);
+	if (peer)
+		return peer;
+	peer = g_new0(struct peer, 1);
+	peer->device = btd_device_ref(device);
+	peer->adapter = device_get_adapter(device);
+	peer->generation = btd_device_ubm_le_generation(device);
+	/* An already-established link is borrowed, never inferred exclusive. */
+	peer->borrowed = peer->generation != 0;
+	peers = g_slist_prepend(peers, peer);
+	return peer;
+}
+
+static struct lease *find_lease(struct btd_adapter *adapter, uint64_t token,
+						const char *sender)
+{
+	GSList *l;
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (token && lease->token == token && lease->adapter == adapter &&
+					!strcmp(lease->sender, sender))
+			return lease;
+	}
+	return NULL;
+}
+
+static struct lease *find_reservation(uint64_t identity, const char *sender)
+{
+	GSList *l;
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (lease->reservation_id == identity &&
+					!strcmp(lease->sender, sender))
+			return lease;
+	}
+	return NULL;
+}
+
+static bool live_sender(struct peer *peer, const char *sender)
+{
+	GSList *l;
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (lease->peer == peer && !lease->released &&
+					!strcmp(lease->sender, sender))
+			return true;
+	}
+	return false;
+}
+
+static unsigned int live_count(struct peer *peer)
+{
+	unsigned int count = 0;
+	GSList *l;
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (lease->peer == peer && !lease->released)
+			count++;
+	}
+	return count;
+}
+
+static void drop_operations(struct interest *interest)
+{
+	GSList *next, *l;
+	for (l = operations; l; l = next) {
+		struct operation *operation = l->data;
+		next = l->next;
+		if (operation->interest != interest)
+			continue;
+		operations = g_slist_delete_link(operations, l);
+		g_free(operation);
+	}
+}
+
+static void interest_dead(DBusConnection *conn, void *data)
+{
+	struct interest *interest = data;
+	GSList *l;
+	(void) conn;
+	drop_operations(interest);
+	for (l = peers; l; l = l->next) {
+		struct peer *peer = l->data;
+		if (g_slist_find(peer->interests, interest)) {
+			peer->interests = g_slist_remove(peer->interests, interest);
+			break;
+		}
+	}
+	interest->watch = 0;
+	g_free(interest->sender);
+	g_free(interest);
+}
+
+static struct interest *interest_lookup(struct peer *peer, const char *sender)
+{
+	GSList *l;
+	for (l = peer->interests; l; l = l->next) {
+		struct interest *interest = l->data;
+		if (!strcmp(interest->sender, sender))
+			return interest;
+	}
+	return NULL;
+}
+
+static struct interest *interest_track(struct peer *peer, const char *sender)
+{
+	struct interest *interest = interest_lookup(peer, sender);
+	if (interest)
+		return interest;
+	if (g_slist_length(peer->interests) >= MAX_INTERESTS) {
+		peer->unknown_interest = true;
+		return NULL;
+	}
+	interest = g_new0(struct interest, 1);
+	interest->sender = g_strdup(sender);
+	interest->watch = g_dbus_add_disconnect_watch(btd_get_dbus_connection(),
+					sender, interest_dead, interest, NULL);
+	if (!interest->watch) {
+		peer->unknown_interest = true;
+		g_free(interest->sender);
+		g_free(interest);
+		return NULL;
+	}
+	peer->interests = g_slist_prepend(peer->interests, interest);
+	return interest;
+}
+
+static void retire_interest(struct interest *interest)
+{
+	GSList *l;
+	guint watch;
+	drop_operations(interest);
+	for (l = peers; l; l = l->next) {
+		struct peer *peer = l->data;
+		if (g_slist_find(peer->interests, interest)) {
+			peer->interests = g_slist_remove(peer->interests, interest);
+			break;
+		}
+	}
+	watch = interest->watch;
+	interest->watch = 0;
+	if (watch)
+		g_dbus_remove_watch(btd_get_dbus_connection(), watch);
+	g_free(interest->sender);
+	g_free(interest);
+}
+
+static void release_interest_if_idle(struct interest *interest)
+{
+	if (interest->inflight || interest->held)
+		return;
+	retire_interest(interest);
+}
+
+bool btd_ubm_le_admit(struct btd_device *device, DBusMessage *message)
+{
+	struct peer *peer = find_peer(device);
+	const char *sender = message ? dbus_message_get_sender(message) : NULL;
+	struct interest *interest;
+	if (!peer)
+		return true;
+	if (peer->releasing)
+		return false;
+	if (!sender) {
+		peer->unknown_interest = true;
+		return true;
+	}
+	if (live_sender(peer, sender))
+		return true;
+	interest = interest_track(peer, sender);
+	if (interest)
+		interest->held = true;
+	return true;
+}
+
+static bool operation_pending(DBusMessage *message)
+{
+	GSList *l;
+	for (l = operations; l; l = l->next)
+		if (((struct operation *) l->data)->message == message)
+			return true;
+	return false;
+}
+
+bool btd_ubm_le_operation_pending(DBusMessage *message)
+{
+	return message && operation_pending(message);
+}
+
+bool btd_ubm_le_operation_begin(struct btd_device *device, DBusMessage *message)
+{
+	struct peer *peer = find_peer(device);
+	const char *sender = message ? dbus_message_get_sender(message) : NULL;
+	struct interest *interest;
+	struct operation *operation;
+	if (!peer)
+		return true;
+	if (peer->releasing)
+		return false;
+	if (!message || !sender) {
+		peer->unknown_interest = true;
+		return true;
+	}
+	if (live_sender(peer, sender) || operation_pending(message))
+		return true;
+	interest = interest_track(peer, sender);
+	if (!interest)
+		return true;
+	interest->inflight++;
+	operation = g_new0(struct operation, 1);
+	operation->message = message;
+	operation->interest = interest;
+	operations = g_slist_prepend(operations, operation);
+	return true;
+}
+
+void btd_ubm_le_operation_end_message(DBusMessage *message)
+{
+	GSList *l;
+	struct operation *operation = NULL;
+	if (!message)
+		return;
+	for (l = operations; l; l = l->next) {
+		struct operation *candidate = l->data;
+		if (candidate->message == message) {
+			operation = candidate;
+			break;
+		}
+	}
+	if (!operation)
+		return;
+	operations = g_slist_remove(operations, operation);
+	if (operation->interest->inflight)
+		operation->interest->inflight--;
+	release_interest_if_idle(operation->interest);
+	g_free(operation);
+}
+
+bool btd_ubm_le_internal_activity(struct btd_device *device)
+{
+	struct peer *peer;
+	if (device == own_connect)
+		return true;
+	peer = find_peer(device);
+	/* Arming auto-connect while probing profiles is daemon bookkeeping.
+	 * It is not another application's hold on a link we created. */
+	if (peer && peer->born_exclusive && peer->generation && !peer->releasing)
+		return true;
+	return btd_ubm_le_admit(device, NULL);
+}
+
+int btd_ubm_le_connect(struct btd_device *device, DBusMessage *message)
+{
+	int error;
+	if (!btd_ubm_le_admit(device, message))
+		return -EBUSY;
+	own_connect = device;
+	error = device_connect_le(device);
+	own_connect = NULL;
+	return error;
+}
+
+static void send_receipts(struct lease *lease)
+{
+	uint32_t version = 2;
+	GSList *l;
+	if (!lease->receipt)
+		return;
+	for (l = lease->releases; l; l = l->next) {
+		DBusMessage *message = l->data;
+		if (!g_dbus_send_reply(btd_get_dbus_connection(), message,
+			DBUS_TYPE_UINT32, &version,
+			DBUS_TYPE_UINT64, &lease->token,
+			DBUS_TYPE_UINT64, &lease->generation,
+			DBUS_TYPE_STRING, &lease->receipt,
+			DBUS_TYPE_BOOLEAN, &lease->has_disconnect_reason,
+			DBUS_TYPE_BYTE, &lease->disconnect_reason, DBUS_TYPE_INVALID))
+			g_warning("LE lease receipt delivery failed; retained token %" G_GUINT64_FORMAT,
+						lease->token);
+		dbus_message_unref(message);
+	}
+	g_slist_free(lease->releases);
+	lease->releases = NULL;
+}
+
+static void fail_releases(struct lease *lease, const char *reason)
+{
+	GSList *l;
+	for (l = lease->releases; l; l = l->next) {
+		DBusMessage *message = l->data;
+		if (!g_dbus_send_message(btd_get_dbus_connection(),
+				btd_error_failed(message, reason)))
+			g_warning("LE lease failure delivery failed; retained token %" G_GUINT64_FORMAT,
+						lease->token);
+		dbus_message_unref(message);
+	}
+	g_slist_free(lease->releases);
+	lease->releases = NULL;
+}
+
+static void release_peer(struct lease *lease)
+{
+	struct peer *peer = lease->peer;
+	if (!peer)
+		return;
+	if (peer->withdrawn) {
+		fail_releases(lease, "Original LE controller authority was removed");
+		return;
+	}
+	if (lease->connecting)
+		return; /* Accepted connect is fenced until its own answer. */
+	if (!lease->generation && !lease->accepted) {
+		lease->receipt = "reservation-released";
+	} else if (!lease->generation) {
+		/* Failed accepted attempts are not proof that queued kernel work had
+		 * no physical effect. Keep the cleanup scope explicitly unknown. */
+		lease->receipt = "lease-released-indeterminate";
+	} else if (peer->generation != lease->generation) {
+		lease->receipt = "physical-released";
+	} else if (live_count(peer) || peer->interests ||
+			(peer->borrowed && !btd_device_is_initiator(peer->device))) {
+		/* Another live lease, a tracked application hold, or a link this
+		 * controller did not initiate stays owned. Daemon auto-connect is
+		 * not that kind of holder. */
+		lease->receipt = "lease-released-protected";
+	} else if (peer->unknown_interest ||
+			(!peer->born_exclusive && !btd_device_is_initiator(peer->device))) {
+		lease->receipt = "lease-released-indeterminate";
+	} else if (!peer->releasing) {
+		int error;
+		peer->releasing = true;
+		btd_device_quiesce_untrusted_auto_connect(peer->device);
+		error = btd_adapter_disconnect_device(peer->adapter,
+			device_get_address(peer->device),
+			device_get_le_address_type(peer->device));
+		if (error < 0) {
+			peer->releasing = false;
+			fail_releases(lease, strerror(-error));
+		}
+		return; /* Only actual kernel disconnect can confirm physical end. */
+	} else {
+		return;
+	}
+	send_receipts(lease);
+}
+
+static void owner_dead(DBusConnection *conn, void *data)
+{
+	struct lease *lease = data;
+	(void) conn;
+	lease->watch = 0;
+	lease->owner_dead = true;
+	lease->released = true;
+	/* Do not free accepted connect state while callbacks may still arrive. */
+	release_peer(lease);
+	g_idle_add(collect_dead, NULL);
+}
+
+static DBusMessage *reserve(DBusConnection *conn, DBusMessage *message,
+						void *data)
+{
+	struct btd_adapter *adapter = data;
+	struct btd_device *device;
+	struct lease *lease;
+	const char *path;
+	uint64_t reservation_id;
+	const char *sender = dbus_message_get_sender(message);
+	(void) conn;
+	if (!sender || !dbus_message_get_args(message, NULL,
+			DBUS_TYPE_OBJECT_PATH, &path,
+			DBUS_TYPE_UINT64, &reservation_id, DBUS_TYPE_INVALID) ||
+			!reservation_id)
+		return btd_error_invalid_args(message);
+	lease = find_reservation(reservation_id, sender);
+	if (lease) {
+		if (lease->adapter != adapter)
+			return btd_error_invalid_args(message);
+		if (!lease->token || lease->released)
+			return btd_error_not_permitted(message, "Reservation is fenced or retired");
+		if (strcmp(lease->path, path))
+			return btd_error_invalid_args(message);
+		return g_dbus_create_reply(message, DBUS_TYPE_UINT64,
+					&lease->token, DBUS_TYPE_INVALID);
+	}
+	struct history *history = get_history(adapter, sender);
+	if (!history)
+		return btd_error_failed(message, "Cannot retain reservation history");
+	if (contains(history->reservations, reservation_id))
+		return btd_error_not_permitted(message, "Reservation identity is fenced");
+	if (history->token_serial == UINT32_MAX || g_slist_length(leases) >= MAX_TOKENS)
+		return g_dbus_create_error(message, LEASE ".Error.Capacity",
+					"Retained lease capacity exhausted");
+	device = btd_adapter_find_device_by_path(adapter, path);
+	if (!device)
+		return btd_error_does_not_exist(message);
+	if (find_peer(device) && find_peer(device)->releasing)
+		return btd_error_in_progress(message);
+	lease = g_new0(struct lease, 1);
+	lease->token = ((uint64_t) history->token_namespace << 32) |
+						++history->token_serial;
+	lease->reservation_id = reservation_id;
+	lease->adapter = adapter;
+	lease->path = g_strdup(path);
+	lease->peer = get_peer(device);
+	lease->sender = g_strdup(sender);
+	lease->watch = g_dbus_add_disconnect_watch(btd_get_dbus_connection(),
+					sender, owner_dead, lease, NULL);
+	if (!lease->watch) {
+		g_free(lease->sender);
+		g_free(lease->path);
+		g_free(lease);
+		return btd_error_failed(message, "Cannot retain sender ownership");
+	}
+	leases = g_slist_prepend(leases, lease);
+	return g_dbus_create_reply(message, DBUS_TYPE_UINT64, &lease->token,
+							DBUS_TYPE_INVALID);
+}
+
+static DBusMessage *recover(DBusConnection *conn, DBusMessage *message,
+						void *data)
+{
+	struct btd_adapter *adapter = data;
+	struct lease *lease;
+	uint64_t reservation_id;
+	const char *sender = dbus_message_get_sender(message);
+	(void) conn;
+	if (!sender || !dbus_message_get_args(message, NULL,
+			DBUS_TYPE_UINT64, &reservation_id, DBUS_TYPE_INVALID) ||
+			!reservation_id)
+		return btd_error_invalid_args(message);
+	lease = find_reservation(reservation_id, sender);
+	if (lease && lease->adapter != adapter)
+		return btd_error_invalid_args(message);
+	if (lease)
+		return g_dbus_create_reply(message, DBUS_TYPE_UINT64,
+					&lease->token, DBUS_TYPE_INVALID);
+	struct history *history = get_history(adapter, sender);
+	if (!history || !add_fence(history->reservations, reservation_id))
+		return g_dbus_create_error(message, LEASE ".Error.Capacity",
+					"Cannot establish no-admission fence");
+	/* A delayed Reserve using this exact sender/identity cannot create effects
+	 * after this zero answer, even if its original request arrives later. */
+	uint64_t no_admission = 0;
+	return g_dbus_create_reply(message, DBUS_TYPE_UINT64, &no_admission,
+							DBUS_TYPE_INVALID);
+}
+
+static DBusMessage *acknowledge(DBusConnection *conn, DBusMessage *message,
+						void *data)
+{
+	struct btd_adapter *adapter = data;
+	const char *sender = dbus_message_get_sender(message);
+	struct history *history;
+	struct lease *lease;
+	uint64_t token;
+	(void) conn;
+	if (!sender || !dbus_message_get_args(message, NULL,
+			DBUS_TYPE_UINT64, &token, DBUS_TYPE_INVALID) || !token)
+		return btd_error_invalid_args(message);
+	history = get_history(adapter, sender);
+	if (!history)
+		return btd_error_failed(message, "Cannot retain acknowledged ownership");
+	if (contains(history->tokens, token))
+		return dbus_message_new_method_return(message);
+	lease = find_lease(adapter, token, sender);
+	if (!lease)
+		return btd_error_does_not_exist(message);
+	if (!lease->receipt || (strcmp(lease->receipt, "physical-released") &&
+				strcmp(lease->receipt, "reservation-released")))
+		return btd_error_not_permitted(message, "Release is not terminal");
+	if (!add_fence(history->reservations, lease->reservation_id) ||
+					!add_fence(history->tokens, token))
+		return g_dbus_create_error(message, LEASE ".Error.Capacity",
+					"Cannot retain exact terminal acknowledgement fence");
+	free_lease(lease);
+	g_idle_add(collect_dead, NULL);
+	return dbus_message_new_method_return(message);
+}
+
+static struct lease *admitted_token(struct btd_adapter *adapter,
+						DBusMessage *message)
+{
+	uint64_t token;
+	const char *sender = dbus_message_get_sender(message);
+	if (!sender || !dbus_message_get_args(message, NULL,
+			DBUS_TYPE_UINT64, &token, DBUS_TYPE_INVALID))
+		return NULL;
+	return find_lease(adapter, token, sender);
+}
+
+static DBusMessage *connect_lease(DBusConnection *conn, DBusMessage *message,
+						void *data)
+{
+	struct lease *lease = admitted_token(data, message);
+	struct peer *peer;
+	int error;
+	(void) conn;
+	if (!lease)
+		return btd_error_does_not_exist(message);
+	if (lease->released)
+		return btd_error_not_permitted(message, "Lease is retired");
+	peer = lease->peer;
+	if (peer->releasing || lease->connecting)
+		return btd_error_in_progress(message);
+	if (btd_adapter_find_device_by_path(peer->adapter, lease->path) != peer->device)
+		return btd_error_does_not_exist(message);
+	if (peer->generation) {
+		lease->generation = peer->generation;
+		return g_dbus_create_reply(message, DBUS_TYPE_UINT64,
+				&lease->generation, DBUS_TYPE_INVALID);
+	}
+	lease->connecting = true;
+	lease->connect = dbus_message_ref(message);
+	/* Join only an already-owned accepted attempt, never an unknown attempt. */
+	if (device_is_connecting(peer->device)) {
+		GSList *l;
+		for (l = leases; l; l = l->next) {
+			struct lease *other = l->data;
+			if (other != lease && other->peer == peer && other->connecting) {
+				lease->accepted = true;
+				return NULL;
+			}
+		}
+		error = -EBUSY;
+	} else {
+		lease->accepted = true;
+		own_connect = peer->device;
+		error = device_connect_le(peer->device);
+		own_connect = NULL;
+	}
+	if (error < 0)
+		btd_ubm_le_connect_failed(peer->device, error);
+	return NULL;
+}
+
+static DBusMessage *release_lease(DBusConnection *conn, DBusMessage *message,
+						void *data)
+{
+	struct lease *lease = admitted_token(data, message);
+	(void) conn;
+	if (!lease)
+		return btd_error_does_not_exist(message);
+	if (g_slist_length(lease->releases) >= 32)
+		return btd_error_in_progress(message);
+	lease->released = true;
+	/* Protected/indeterminate receipts are retry-observed, not frozen success. */
+	lease->receipt = NULL;
+	lease->releases = g_slist_append(lease->releases,
+						 dbus_message_ref(message));
+	release_peer(lease);
+	return NULL;
+}
+
+void btd_ubm_le_connected(struct btd_device *device, uint64_t generation,
+						bool initiator)
+{
+	struct peer *peer = find_peer(device);
+	bool own = false;
+	GSList *l;
+	if (!peer)
+		return;
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (lease->peer == peer && lease->connecting)
+			own = true;
+	}
+	peer->generation = generation;
+	peer->born_exclusive = generation && own && initiator;
+	peer->borrowed = !peer->born_exclusive;
+	if (!peer->born_exclusive)
+		peer->unknown_interest = true;
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (lease->peer != peer || !lease->connecting)
+			continue;
+		lease->generation = generation;
+		lease->connecting = false;
+		if (!g_dbus_send_message(btd_get_dbus_connection(), generation ?
+			g_dbus_create_reply(lease->connect, DBUS_TYPE_UINT64,
+				&generation, DBUS_TYPE_INVALID) :
+			btd_error_failed(lease->connect, "Physical identity exhausted")))
+			g_warning("LE connect reply delivery failed; retained token %" G_GUINT64_FORMAT,
+						lease->token);
+		dbus_message_unref(lease->connect);
+		lease->connect = NULL;
+	}
+	/* Complete every accepted connect before compensating released joiners. */
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (lease->peer == peer && lease->released)
+			release_peer(lease);
+	}
+	g_idle_add(collect_dead, NULL);
+}
+
+void btd_ubm_le_connect_failed(struct btd_device *device, int error)
+{
+	GSList *l;
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (!lease->peer || lease->peer->device != device || !lease->connecting)
+			continue;
+		lease->connecting = false;
+		lease->generation = btd_device_ubm_le_generation(device);
+		if (!g_dbus_send_message(btd_get_dbus_connection(),
+				btd_error_failed(lease->connect, strerror(-error))))
+			g_warning("LE connect failure delivery failed; retained token %" G_GUINT64_FORMAT,
+						lease->token);
+		dbus_message_unref(lease->connect);
+		lease->connect = NULL;
+		if (lease->released)
+			release_peer(lease);
+	}
+	g_idle_add(collect_dead, NULL);
+}
+
+void btd_ubm_le_lost(struct btd_device *device, uint64_t generation, uint8_t reason)
+{
+	struct peer *peer = find_peer(device);
+	GSList *l;
+	if (!peer || peer->generation != generation || !generation)
+		return;
+	/* The operation's own reply retains the exact kernel observation even
+	 * when the client consumes that reply before its signal callback runs. */
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (lease->peer == peer && lease->generation == generation) {
+			lease->has_disconnect_reason = TRUE;
+			lease->disconnect_reason = reason;
+		}
+	}
+	peer->generation = 0;
+	peer->releasing = false;
+	peer->born_exclusive = false;
+	peer->borrowed = false;
+	peer->unknown_interest = false;
+	/* Sender interests belonged to the ended physical generation, not every
+	 * future link to this address. Internal autoconnect is observed afresh. */
+	while (peer->interests)
+		retire_interest(peer->interests->data);
+	const char *path = device_get_path(device);
+	if (!g_dbus_emit_signal(btd_get_dbus_connection(),
+		adapter_get_path(peer->adapter), LEASE, "PhysicalLost",
+		DBUS_TYPE_OBJECT_PATH, &path, DBUS_TYPE_UINT64, &generation,
+		DBUS_TYPE_BYTE, &reason,
+		DBUS_TYPE_INVALID))
+		g_warning("LE lease physical loss signal failed for generation %" G_GUINT64_FORMAT,
+					generation);
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (lease->peer == peer && lease->released &&
+					lease->generation == generation) {
+			lease->receipt = "physical-released";
+			send_receipts(lease);
+		}
+	}
+	g_idle_add(collect_dead, NULL);
+}
+
+static DBusMessage *get_contract(DBusConnection *conn, DBusMessage *message,
+						void *data)
+{
+	uint32_t protocol = 1, lease = 2, gatt = 1;
+	(void) conn;
+	(void) data;
+	/* Versioned producer and fresh ATT observer are verified together. */
+	return g_dbus_create_reply(message, DBUS_TYPE_UINT32, &protocol,
+		DBUS_TYPE_UINT32, &lease, DBUS_TYPE_UINT32, &gatt, DBUS_TYPE_INVALID);
+}
+
+void btd_ubm_le_adapter_lost(struct btd_adapter *adapter,
+					const bdaddr_t *address, uint8_t type, uint8_t reason)
+{
+	GSList *l;
+	if (type == BDADDR_BREDR)
+		return;
+	/* A removed original object can no longer be found in Adapter1's live
+	 * list. Retained tokens still observe its controller-level LE end by
+	 * original device identity; no lookup or retarget to a recreated path. */
+	for (l = peers; l; l = l->next) {
+		struct peer *peer = l->data;
+		if (peer->adapter == adapter && peer->generation &&
+			device_get_le_address_type(peer->device) == type &&
+			!bacmp(device_get_address(peer->device), address)) {
+			uint64_t generation = peer->generation;
+			btd_ubm_le_lost(peer->device, generation, reason);
+			btd_device_ubm_le_generation_lost(peer->device, generation);
+		}
+	}
+}
+
+void btd_ubm_le_disconnect_failed(struct btd_adapter *adapter,
+		const bdaddr_t *address, uint8_t type, uint64_t generation, const char *reason)
+{
+	GSList *l, *owned;
+	if (type == BDADDR_BREDR || !generation)
+		return;
+	for (l = peers; l; l = l->next) {
+		struct peer *peer = l->data;
+		if (peer->adapter != adapter || !peer->releasing || peer->generation != generation ||
+			device_get_le_address_type(peer->device) != type ||
+			bacmp(device_get_address(peer->device), address))
+			continue;
+		peer->releasing = false;
+		for (owned = leases; owned; owned = owned->next) {
+			struct lease *lease = owned->data;
+			if (lease->peer == peer)
+				fail_releases(lease, reason);
+		}
+	}
+}
+
+uint64_t btd_ubm_le_releasing_generation(struct btd_adapter *adapter,
+		const bdaddr_t *address, uint8_t type)
+{
+	GSList *l;
+	for (l = peers; l; l = l->next) {
+		struct peer *peer = l->data;
+		if (peer->adapter == adapter && peer->releasing &&
+			device_get_le_address_type(peer->device) == type &&
+			!bacmp(device_get_address(peer->device), address))
+			return peer->generation;
+	}
+	return 0;
+}
+
+static const GDBusMethodTable contract_methods[] = {
+	{ GDBUS_METHOD("GetLeAvailability", NULL,
+		GDBUS_ARGS({"version", "u"}, {"sequence", "t"}), get_le_availability) },
+	{ GDBUS_METHOD("GetContract", NULL,
+		GDBUS_ARGS({"protocol", "u"}, {"lease", "u"}, {"gatt", "u"}),
+		get_contract) },
+	{}
+};
+static const GDBusSignalTable availability_signals[] = {
+	{ GDBUS_SIGNAL("LeAdvertisement", GDBUS_ARGS({"device", "o"}, {"sequence", "t"})) },
+	{}
+};
+static const GDBusMethodTable lease_methods[] = {
+	{ GDBUS_METHOD("ReserveLease", GDBUS_ARGS({"device", "o"}, {"reservation", "t"}),
+		GDBUS_ARGS({"token", "t"}), reserve) },
+	{ GDBUS_METHOD("RecoverLease", GDBUS_ARGS({"reservation", "t"}),
+		GDBUS_ARGS({"token", "t"}), recover) },
+	{ GDBUS_METHOD("AckLease", GDBUS_ARGS({"token", "t"}), NULL, acknowledge) },
+	{ GDBUS_ASYNC_METHOD("ConnectLease", GDBUS_ARGS({"token", "t"}),
+		GDBUS_ARGS({"generation", "t"}), connect_lease) },
+	{ GDBUS_ASYNC_METHOD("ReleaseLease", GDBUS_ARGS({"token", "t"}),
+		GDBUS_ARGS({"version", "u"}, {"token", "t"},
+			{"generation", "t"}, {"scope", "s"},
+			{"has_reason", "b"}, {"reason", "y"}), release_lease) },
+	{}
+};
+static const GDBusSignalTable lease_signals[] = {
+	{ GDBUS_SIGNAL("PhysicalLost", GDBUS_ARGS({"device", "o"}, {"generation", "t"}, {"reason", "y"})) },
+	{}
+};
+
+bool btd_ubm_le_register(struct btd_adapter *adapter)
+{
+	DBusConnection *conn = btd_get_dbus_connection();
+	const char *path = adapter_get_path(adapter);
+	if (!g_dbus_register_interface(conn, path, LEASE, lease_methods,
+					lease_signals, NULL, adapter, NULL))
+		return false;
+	if (!g_dbus_register_interface(conn, path, AUTHORITY, contract_methods,
+					availability_signals, NULL, adapter, NULL)) {
+		g_dbus_unregister_interface(conn, path, LEASE);
+		return false;
+	}
+	return true;
+}
+
+void btd_ubm_le_unregister(struct btd_adapter *adapter)
+{
+	/* Do not fabricate physical release on controller/object disappearance. */
+	GSList *l;
+	for (l = peers; l; l = l->next) {
+		struct peer *peer = l->data;
+		if (peer->adapter == adapter) {
+			peer->withdrawn = true;
+			peer->releasing = false;
+			btd_ubm_le_connect_failed(peer->device, -ENODEV);
+		}
+	}
+	for (l = leases; l; l = l->next) {
+		struct lease *lease = l->data;
+		if (lease->adapter == adapter)
+			fail_releases(lease, "Original LE controller authority was removed");
+	}
+	g_dbus_unregister_interface(btd_get_dbus_connection(),
+					adapter_get_path(adapter), AUTHORITY);
+	g_dbus_unregister_interface(btd_get_dbus_connection(),
+					adapter_get_path(adapter), LEASE);
+}
--- a/src/ubm-le-lease.h
