@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef UBM_LE_LEASE_H
+#define UBM_LE_LEASE_H
+
+struct btd_adapter;
+struct btd_device;
+
+bool btd_ubm_le_register(struct btd_adapter *adapter);
+void btd_ubm_le_advertisement(struct btd_adapter *adapter,
+		struct btd_device *device, uint8_t type, bool connectable);
+void btd_ubm_le_unregister(struct btd_adapter *adapter);
+/* Admissions run on bluetoothd's single GLib context, before native effects.
+ * Admit holds until that sender's bus connection dies (connect, pair, notify,
+ * acquire). A read or write holds only while its ATT operation is in flight. */
+bool btd_ubm_le_admit(struct btd_device *device, DBusMessage *message);
+bool btd_ubm_le_operation_begin(struct btd_device *device, DBusMessage *message);
+bool btd_ubm_le_operation_pending(DBusMessage *message);
+void btd_ubm_le_operation_end_message(DBusMessage *message);
+bool btd_ubm_le_internal_activity(struct btd_device *device);
+int btd_ubm_le_connect(struct btd_device *device, DBusMessage *message);
+void btd_ubm_le_connected(struct btd_device *device, uint64_t generation,
+						bool initiator);
+void btd_ubm_le_connect_failed(struct btd_device *device, int error);
+void btd_ubm_le_lost(struct btd_device *device, uint64_t generation, uint8_t reason);
+void btd_ubm_le_adapter_lost(struct btd_adapter *adapter,
+					const bdaddr_t *address, uint8_t type, uint8_t reason);
+void btd_ubm_le_disconnect_failed(struct btd_adapter *adapter,
+		const bdaddr_t *address, uint8_t type, uint64_t generation, const char *reason);
+uint64_t btd_ubm_le_releasing_generation(struct btd_adapter *adapter,
+		const bdaddr_t *address, uint8_t type);
+
+#endif
--- a/unit/test-ubm-att-exchange.c
+++ b/unit/test-ubm-att-exchange.c
@@ -0,0 +1,119 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+/* Actual ATT registration and indication paths; no Bluetooth/system bus. */
+#define queue_push_tail test_queue_push_tail
+#define free test_free
+#include "src/shared/att.c"
+#undef queue_push_tail
+#undef free
+#include <assert.h>
+#include <stdio.h>
+#include <fcntl.h>
+#include <glib.h>
+#include "src/shared/gatt-db.h"
+#include "src/shared/gatt-server.h"
+
+static struct queue *refused_queue;
+static struct bt_att *watched_att;
+static unsigned int premature_att_frees;
+bool queue_push_tail(struct queue *queue, void *data);
+void free(void *data);
+
+bool test_queue_push_tail(struct queue *queue, void *data)
+{
+	return queue == refused_queue ? false : queue_push_tail(queue, data);
+}
+
+void test_free(void *data)
+{
+	/* Track the actual helper's erroneous free without letting allocator
+	 * reuse hide the ownership violation in a later caller assertion. */
+	if (watched_att && data == watched_att) {
+		premature_att_frees++;
+		return;
+	}
+	free(data);
+}
+
+static void disconnected(int err, void *data) { }
+static void exchanged(uint16_t mtu, void *data) { }
+
+static void confirmed_indication(struct bt_att_chan *chan, uint16_t mtu,
+		uint8_t opcode, const void *pdu, uint16_t length, void *user_data)
+{
+	unsigned int *delivered = user_data;
+	assert(opcode == BT_ATT_OP_HANDLE_IND);
+	(*delivered)++;
+	bt_att_chan_send(chan, BT_ATT_OP_HANDLE_CONF, NULL, 0,
+						NULL, NULL, NULL);
+}
+
+static void incoming_server_indication(void)
+{
+	int sockets[2];
+	uint8_t pdu[] = { BT_ATT_OP_HANDLE_IND, 0x08, 0x00,
+						0x0a, 0x00, 0xff, 0xff };
+	uint8_t response[16];
+	unsigned int delivered = 0;
+	assert(!socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets));
+	struct bt_att *att = bt_att_new(sockets[0], false);
+	struct gatt_db *db = gatt_db_new();
+	assert(att && db);
+	/* Same server-only ATT shape as an incoming peer with reverse discovery
+	 * disabled: requests have server handlers, indications have no client. */
+	struct bt_gatt_server *server = bt_gatt_server_new(db, att, 23, 0);
+	assert(server);
+	assert(fcntl(sockets[1], F_SETFL, O_NONBLOCK) == 0);
+	assert(send(sockets[1], pdu, sizeof(pdu), 0) == sizeof(pdu));
+	while (g_main_context_iteration(NULL, false)) { }
+	ssize_t received = recv(sockets[1], response, sizeof(response), 0);
+	assert(received == 1 && response[0] == BT_ATT_OP_HANDLE_CONF);
+	assert(delivered == 0); /* A confirmation invents no app delivery. */
+	assert(recv(sockets[1], response, sizeof(response), 0) == -1 &&
+					(errno == EAGAIN || errno == EWOULDBLOCK));
+	/* A registered handler still owns confirmation; fallback must not
+	 * send a second response, even when a server shares this ATT. */
+	unsigned int id = bt_att_register(att, BT_ATT_OP_HANDLE_IND,
+				confirmed_indication, &delivered, NULL);
+	assert(id);
+	assert(send(sockets[1], pdu, sizeof(pdu), 0) == sizeof(pdu));
+	while (g_main_context_iteration(NULL, false)) { }
+	received = recv(sockets[1], response, sizeof(response), 0);
+	assert(received == 1 && response[0] == BT_ATT_OP_HANDLE_CONF);
+	assert(delivered == 1);
+	assert(recv(sockets[1], response, sizeof(response), 0) == -1 &&
+					(errno == EAGAIN || errno == EWOULDBLOCK));
+	assert(bt_att_unregister(att, id));
+	bt_gatt_server_unref(server);
+	gatt_db_unref(db);
+	bt_att_unref(att);
+	close(sockets[1]);
+	puts("Incoming server-only indication confirms exactly once: OK");
+}
+
+int main(void)
+{
+	incoming_server_indication();
+	int sockets[2];
+	unsigned int disconnect_id;
+	assert(!socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets));
+	struct bt_att *att = bt_att_new(sockets[0], false);
+	assert(att);
+	disconnect_id = bt_att_register_disconnect(att, disconnected, NULL, NULL);
+	assert(disconnect_id);
+	watched_att = att;
+	refused_queue = att->exchange_list;
+	assert(bt_att_register_exchange(att, exchanged, NULL, NULL) == 0);
+	assert(premature_att_frees == 0);
+	/* The new daemon caller rolls back its disconnect handler on refusal. */
+	assert(bt_att_unregister_disconnect(att, disconnect_id));
+	assert(bt_att_get_fd(att) == sockets[0]);
+	assert(bt_att_set_mtu(att, 247));
+	refused_queue = NULL;
+	unsigned int exchange_id = bt_att_register_exchange(att, exchanged, NULL, NULL);
+	assert(exchange_id && bt_att_unregister_exchange(att, exchange_id));
+	watched_att = NULL;
+	bt_att_unref(att);
+	close(sockets[1]);
+	puts("Actual ATT exchange queue refusal preserves caller ownership: OK");
+	return 0;
+}
--- a/unit/test-ubm-bonded-notify.c
+++ b/unit/test-ubm-bonded-notify.c
@@ -0,0 +1,567 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Production CCC/ATT/socket callbacks; no radio or system D-Bus. */
+#define g_dbus_proxy_get_property test_proxy_get_property
+#define g_dbus_proxy_method_call test_proxy_method_call
