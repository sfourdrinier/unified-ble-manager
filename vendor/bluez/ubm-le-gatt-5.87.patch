+	assert(!find_peer(&device)->interests);
+	DBusConnection *external = g_dbus_setup_private(DBUS_BUS_SESSION, NULL, &error);
+	assert(external);
+	DBusMessage *interest = dbus_message_new_method_call("org.ubm.Test",
+		device_get_path(&device), "org.bluez.GattCharacteristic1", "ReadValue");
+	assert(dbus_message_set_sender(interest, dbus_bus_get_unique_name(external)));
+	assert(btd_ubm_le_operation_begin(&device, interest));
