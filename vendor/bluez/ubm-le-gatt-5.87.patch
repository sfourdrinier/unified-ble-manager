+						bt_att_get_link_type(att));
+	if (!op)
+		return BT_ATT_ERROR_UNLIKELY;
+	op->ccc_rearm = true;
+	op->ccc_existing = true;
+	ecode = ccc_write_cb(op, chrc);
+	if (ecode)
+		pending_op_free(op);
+	return ecode;
