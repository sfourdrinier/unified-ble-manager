+	send_call(client, "AckLease", pending, &replay);
+	await_call(&replay);
+	clear_call(&replay);
+	/* Two live senders interleaving normal completion must not exhaust history. */
+	DBusConnection *alternating = g_dbus_setup_private(DBUS_BUS_SESSION, NULL, &error);
+	assert(alternating);
+	for (unsigned int cycle = 0; cycle < MAX_TOKENS + 32; cycle++) {
+		DBusConnection *senders[] = { client, alternating };
+		for (unsigned int who = 0; who < 2; who++) {
+			uint64_t next = reserve_token(senders[who]);
