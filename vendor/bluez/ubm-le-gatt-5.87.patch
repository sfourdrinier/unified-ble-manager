+static void ubm_emit(struct btd_device *device)
+{
+	if (device->ubm_registered)
+		g_dbus_emit_signal(dbus_conn, device->path,
+				UBM_LE_GATT_INTERFACE, "Invalidated",
+				DBUS_TYPE_UINT64, &device->ubm_gatt.attachment,
+				DBUS_TYPE_UINT64, &device->ubm_gatt.revision,
+				DBUS_TYPE_INVALID);
