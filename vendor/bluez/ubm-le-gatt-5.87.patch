+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include "src/ubm-gatt-state.h"
+
+int main(void)
+{
+	struct ubm_gatt_state state = { 0 };
+	uint64_t attachment, revision;
+	struct ubm_gatt_refresh refresh = { 0 };
+
+	ubm_gatt_refresh_begin(&refresh);
+	ubm_gatt_refresh_begin(&refresh);
+	assert(!ubm_gatt_refresh_finish(&refresh, false, 0x05));
+	assert(refresh.pending == 1 && refresh.failed && refresh.att_error == 5);
+	assert(ubm_gatt_refresh_finish(&refresh, true, 0));
+	assert(refresh.failed && refresh.att_error == 5);
+	ubm_gatt_refresh_begin(&refresh);
+	assert(!refresh.failed);
+	assert(ubm_gatt_refresh_finish(&refresh, true, 0));
+	assert(!refresh.failed && refresh.pending == 0);
+	refresh.pending = UINT64_MAX;
+	ubm_gatt_refresh_begin(&refresh);
+	assert(refresh.exhausted && refresh.failed);
+	assert(!ubm_gatt_refresh_finish(&refresh, true, 0));
+	assert(refresh.pending == UINT64_MAX);
+
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCONNECTED);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	attachment = state.attachment;
+	assert(attachment != 0);
+	ubm_gatt_begin(&state);
+	revision = state.revision;
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCOVERING);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_READY);
+	assert(state.attachment == attachment && state.revision == revision);
+	ubm_gatt_retire(&state);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	ubm_gatt_complete(&state, true, 0);
+	assert(state.status == UBM_GATT_DISCONNECTED && state.attachment == attachment);
+	ubm_gatt_detach(&state);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	attachment = state.attachment;
+	ubm_gatt_complete(&state, true, 0);
+
+	/* An accepted invalidation precedes completion/export of a refresh. */
+	ubm_gatt_begin(&state);
+	assert(state.revision > revision);
+	assert(ubm_gatt_status(&state) != UBM_GATT_READY);
+	ubm_gatt_complete(&state, false, 0x05);
+	assert(ubm_gatt_status(&state) == UBM_GATT_FAILED);
+	assert(state.error == EIO && state.att_error == 0x05);
+	ubm_gatt_begin(&state);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_READY);
+
+	/* A second transport cannot turn the shared client into LE evidence. */
+	ubm_gatt_attach(&state, UBM_GATT_BREDR);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_UNSUPPORTED);
+	assert(state.bearer == UBM_GATT_MIXED && state.error == EOPNOTSUPP);
+	ubm_gatt_detach(&state);
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCONNECTED);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCONNECTED);
+	ubm_gatt_attach(&state, UBM_GATT_BREDR);
+	ubm_gatt_begin(&state);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_UNSUPPORTED);
+	ubm_gatt_detach(&state);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	assert(state.attachment > attachment);
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCOVERING);
+
+	/* Counter wrap is a terminal refusal, never a recycled receipt. */
+	state.revision = UINT64_MAX;
+	ubm_gatt_begin(&state);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_FAILED);
+	assert(state.error == EOVERFLOW);
+	ubm_gatt_detach(&state);
+	assert(state.status == UBM_GATT_FAILED && state.error == EOVERFLOW);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	ubm_gatt_complete(&state, true, 0);
+	assert(state.status == UBM_GATT_FAILED && state.error == EOVERFLOW);
+	puts("LE GATT ownership/status lifecycle: OK");
+	return 0;
+}
diff -ruN a/unit/test-ubm-refresh.c b/unit/test-ubm-refresh.c
--- a/unit/test-ubm-refresh.c	1969-12-31 16:00:00
+++ b/unit/test-ubm-refresh.c	2026-09-27 21:58:48
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+/* Production invalidation/completion paths with no ATT socket or radio. */
+#include "src/shared/gatt-client.c"
+#include <stdio.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+struct observed { unsigned int calls; bool pending, success; uint8_t error; };
+static void observe(bool pending, bool success, int cause, uint8_t error, void *data)
+{
+	struct observed *observed = data;
+	(void) cause;
+	observed->calls++;
+	observed->pending = pending;
+	observed->success = success;
+	observed->error = error;
+}
+
+int main(void)
+{
+	struct bt_gatt_client client = { 0 };
+	struct observed observed = { 0 };
+	struct discovery_op operation = { .client = &client, .start = 1, .end = 9 };
+	struct bt_att_pdu_error_rsp error = { .ecode = BT_ATT_ERROR_DB_OUT_OF_SYNC };
+	uint8_t changed[] = { 1, 0, 9, 0 };
+	client.db = gatt_db_new();
+	client.clones = queue_new();
+	client.svc_chngd_queue = queue_new();
+	bt_gatt_client_set_ubm_discovery_observer(&client, observe, &observed);
+	if (getenv("UBM_TEST_CLONE_ONLY"))
+		goto clone_test;
+	/* A real queued indication invalidates now, before its rediscovery. */
+	client.in_svc_chngd = true;
+	ubm_discovery_begin(&client);
+	service_changed_cb(1, changed, sizeof(changed), &client);
+	service_changed_cb(1, changed, sizeof(changed), &client);
+	assert(observed.calls == 3 && observed.pending && !observed.success);
+	assert(client.ubm_refresh.pending == 3);
+	/* A fails; queued B cannot erase A's own error even if B succeeds. */
+	service_changed_complete(&operation, false, 0x05);
+	/* B's actual dispatch has no socket, and must settle failed, not hang. */
+	assert(!observed.pending && !observed.success && observed.error == 0x05);
+	assert(client.ubm_refresh.pending == 0);
+	assert(queue_isempty(client.svc_chngd_queue));
+	/* Hash-check admission fails synchronously without an ATT socket. */
+	client.in_svc_chngd = false;
+	gatt_client_db_sync_cb(&error, NULL, 0, 7, &client);
+	assert(!observed.pending && !observed.success);
+	assert(client.ubm_refresh.pending == 0);
+	assert(client.pending_retry_att_id == 0);
+	/* Positive queued completion is one cycle, never a ready interlude. */
+	ubm_discovery_begin(&client);
+	ubm_discovery_begin(&client);
+	ubm_discovery_finish(&client, true, 0);
+	assert(observed.pending && !observed.success);
+	ubm_discovery_finish(&client, true, 0);
+	assert(!observed.pending && observed.success);
+clone_test:
+	/* The real clone constructor replaces the shared ATT sync callback.
+	 * A clone's DB-out-of-sync must invalidate its owning database observer. */
+	{
+		int sockets[2];
+		struct bt_att *att;
+		struct bt_gatt_client *parent, *clone;
+		struct observed parent_observed = { 0 };
+		assert(!socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets));
+		att = bt_att_new(sockets[0], false);
+		assert(att);
+		parent = bt_gatt_client_ref(gatt_client_new(client.db, att, 0));
+		assert(parent);
+		parent->ready = true;
+		bt_gatt_client_set_ubm_discovery_observer(parent, observe, &parent_observed);
+		clone = bt_gatt_client_clone(parent);
+		assert(clone && clone->parent == parent);
+		gatt_client_db_sync_cb(&error, NULL, 0, 7, clone);
+		assert(parent_observed.calls > 0 && parent_observed.pending);
+		assert(parent->ubm_refresh.pending == 1);
+		assert(clone->ubm_refresh.pending == 0);
+		bt_gatt_client_unref(clone);
+		bt_gatt_client_unref(parent);
+		bt_att_unref(att);
+		close(sockets[0]);
+		close(sockets[1]);
+	}
+	bt_gatt_client_set_ubm_discovery_observer(&client, NULL, NULL);
+	queue_destroy(client.svc_chngd_queue, free);
+	queue_destroy(client.clones, NULL);
+	gatt_db_unref(client.db);
+	puts("Production refresh ingress/failure settlement: OK");
+	return 0;
+}
