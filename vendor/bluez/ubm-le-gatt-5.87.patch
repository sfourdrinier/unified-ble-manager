+		unsigned int attempts = enables;
+		value[0] = 2;
+		gatt_ccc_write_cb(chrc.ccc, 43, 0, value, 2, 0, att, &database);
+		assert(enables == attempts && chrc.ntfy_cnt == 1);
+		value[0] = 1;
+		gatt_ccc_write_cb(chrc.ccc, 44, 0, value, 2, 0, att, &database);
+		btd_gatt_database_server_connected(&database, server);
+		assert(enables == attempts && chrc.ntfy_cnt == 1);
+	}
+	if (argc > 1 && !strcmp(argv[1], "removed")) goto remove_pending;
+	value[0] = 0;
+	gatt_ccc_write_cb(chrc.ccc, 5, 0, value, 2, 0, att, &database);
+	assert(chrc.ntfy_cnt == 0);
+	finish_notify(0, false);
+	assert(queue_isempty(chrc.notify_ios) && chrc.ntfy_cnt == 0);
+	assert(send(writer_fd, "a", 1, MSG_NOSIGNAL) == -1 && errno == EPIPE);
+	if (argc > 1) return 0;
+	/* Disconnected accepted request cannot create an old-ATT socket later. */
+	value[0] = 1;
+	gatt_ccc_write_cb(chrc.ccc, 6, 0, value, 2, 0, att, &database);
+	assert(chrc.ntfy_cnt == 1);
+	pending_disconnect_cb(0, pending[1].data);
+	att_disconnected(0, state);
+	finish_notify(1, false);
+	assert(queue_isempty(chrc.notify_ios) && chrc.ntfy_cnt == 1);
+	assert(send(writer_fd, "a", 1, MSG_NOSIGNAL) == -1 && errno == EPIPE);
+	/* Rearm failure keeps the bonded CCC/count and never falls back to Fun. */
+	btd_gatt_database_server_connected(&database, server);
+	unsigned int count = enables;
+	btd_gatt_database_server_connected(&database, server);
+	assert(enables == count);
+	finish_notify(2, true);
+	assert(chrc.ntfy_cnt == 1 && starts == 0);
+	gatt_ccc_write_cb(chrc.ccc, 7, 0, value, 2, 0, att, &database);
+	assert(enables == count + 1);
+	finish_notify(3, false);
+	assert(chrc.ntfy_cnt == 1 && queue_length(chrc.notify_ios) == 1);
+	/* A second peer owns its own acquired IO, not another logical count for P1. */
+	struct bt_att *other_att;
+	int other_sockets[2];
+	peer.b[0] = 2;
+	assert(!socketpair(AF_UNIX, SOCK_SEQPACKET, 0, other_sockets));
+	other_att = bt_att_new(other_sockets[0], false);
+	delayed = false;
+	gatt_ccc_write_cb(chrc.ccc, 31, 0, value, 2, 0, other_att, &database);
+	assert(chrc.ntfy_cnt == 2 && queue_length(chrc.notify_ios) == 2);
+	peer.b[0] = 0;
+	client = queue_find(chrc.notify_ios, match_client_att, att);
+	att_disconnect_cb(0, client);
+	sock_hup(client->io, &chrc);
+	att_disconnected(0, state);
+	btd_gatt_database_server_connected(&database, server);
+	assert(chrc.ntfy_cnt == 2 && queue_length(chrc.notify_ios) == 2);
+	value[0] = 0;
+	gatt_ccc_write_cb(chrc.ccc, 32, 0, value, 2, 0, att, &database);
+	assert(chrc.ntfy_cnt == 1 && queue_length(chrc.notify_ios) == 1);
+	peer.b[0] = 2;
+	gatt_ccc_write_cb(chrc.ccc, 33, 0, value, 2, 0, other_att, &database);
+	assert(chrc.ntfy_cnt == 0 && queue_isempty(chrc.notify_ios));
+	bt_att_unref(other_att); close(other_sockets[1]);
+	peer.b[0] = 0;
+	/* Fun notification remains global: reconnect/identical CCC does not replay. */
+	value[0] = 0;
+	gatt_ccc_write_cb(chrc.ccc, 8, 0, value, 2, 0, att, &database);
+	acquired = false; delayed = false; value[0] = 1;
+	gatt_ccc_write_cb(chrc.ccc, 9, 0, value, 2, 0, att, &database);
+	assert(chrc.ntfy_cnt == 1 && starts == 1);
+	att_disconnected(0, state);
+	btd_gatt_database_server_connected(&database, server);
+	gatt_ccc_write_cb(chrc.ccc, 10, 0, value, 2, 0, att, &database);
+	assert(chrc.ntfy_cnt == 1 && starts == 1);
+	value[0] = 0;
+	gatt_ccc_write_cb(chrc.ccc, 11, 0, value, 2, 0, att, &database);
+	/* Synchronous Io rearm refusal keeps CCC/count; identical write can retry. */
+	acquired = true; value[0] = 1;
+	gatt_ccc_write_cb(chrc.ccc, 40, 0, value, 2, 0, att, &database);
+	client = queue_peek_head(chrc.notify_ios);
+	att_disconnect_cb(0, client); sock_hup(client->io, &chrc);
+	refuse = true;
+	unsigned int start_count = starts;
+	btd_gatt_database_server_connected(&database, server);
+	assert(chrc.ntfy_cnt == 1 && queue_isempty(chrc.notify_ios));
+	assert(find_ccc_state(state, gatt_db_attribute_get_handle(chrc.ccc))->value == 1);
+	assert(starts == start_count);
+	refuse = false;
+	gatt_ccc_write_cb(chrc.ccc, 41, 0, value, 2, 0, att, &database);
+	assert(chrc.ntfy_cnt == 1 && queue_length(chrc.notify_ios) == 1);
+	value[0] = 0;
+	gatt_ccc_write_cb(chrc.ccc, 42, 0, value, 2, 0, att, &database);
+	/* Actual object destruction fences a held callback before freeing chrc. */
+	acquired = true; delayed = true; value[0] = 1;
+remove_pending:
+	if (!removed) {
+		removed = malloc(sizeof(*removed));
+		*removed = chrc;
+	}
+	struct ccc_cb_data *cb = queue_peek_head(database.ccc_callbacks);
+	cb->user_data = removed;
+	if (argc == 1) {
+		gatt_ccc_write_cb(chrc.ccc, 12, 0, value, 2, 0, att, &database);
+		assert(removed->ntfy_cnt == 1);
+	}
+	chrc_free(removed);
+	finish_notify(argc == 1 ? 4 : 0, false);
+	assert(send(writer_fd, "a", 1, MSG_NOSIGNAL) == -1 && errno == EPIPE);
+	puts("Production bonded AcquireNotify reconnect: OK");
+	return 0;
+}
--- a/unit/test-ubm-device.c
+++ b/unit/test-ubm-device.c
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Actual private method table/handler on a private D-Bus session only. */
+#include "src/device.c"
+#include <assert.h>
+#include <stdio.h>
+
+static bool projection_complete = true;
+struct btd_opts btd_opts;
+bool btd_gatt_client_projection_complete(struct btd_gatt_client *client)
+{
+	(void) client;
+	return projection_complete;
+}
+static GMainLoop *loop;
+static DBusMessage *received;
+static void reply_received(DBusPendingCall *pending, void *data)
+{
+	(void) data;
+	received = dbus_pending_call_steal_reply(pending);
+	g_main_loop_quit(loop);
+}
+static gboolean watchdog(void *data)
+{
+	(void) data;
+	fprintf(stderr, "private GetSnapshot did not reply\n");
+	abort();
+}
+static void snapshot(DBusConnection *client, const char *expected_status,
+					const char *expected_stage, int expected_error)
+{
+	DBusMessage *request;
+	DBusPendingCall *pending;
+	const char *bearer, *status, *stage;
+	uint32_t version;
+	uint64_t attachment, revision;
+	uint8_t att_error;
+	int32_t error;
+	guint timeout;
+	request = dbus_message_new_method_call("org.ubm.Test", "/org/bluez/test",
+					UBM_LE_GATT_INTERFACE, "GetSnapshot");
+	assert(dbus_connection_send_with_reply(client, request, &pending, 5000));
+	assert(dbus_pending_call_set_notify(pending, reply_received, NULL, NULL));
+	timeout = g_timeout_add_seconds(6, watchdog, NULL);
+	g_main_loop_run(loop);
+	g_source_remove(timeout);
+	assert(received && dbus_message_get_type(received) == DBUS_MESSAGE_TYPE_METHOD_RETURN);
+	assert(!strcmp(dbus_message_get_signature(received), "uttsssiy"));
+	assert(dbus_message_get_args(received, NULL, DBUS_TYPE_UINT32, &version,
+		DBUS_TYPE_UINT64, &attachment, DBUS_TYPE_UINT64, &revision,
+		DBUS_TYPE_STRING, &bearer, DBUS_TYPE_STRING, &status,
+		DBUS_TYPE_STRING, &stage, DBUS_TYPE_INT32, &error,
+		DBUS_TYPE_BYTE, &att_error, DBUS_TYPE_INVALID));
+	assert(version == 1 && attachment > 0 && revision > 0);
+	assert(!strcmp(status, expected_status));
+	assert(!strcmp(stage, expected_stage) && error == expected_error);
+	dbus_message_unref(received);
+	received = NULL;
+	dbus_pending_call_unref(pending);
+	dbus_message_unref(request);
+}
+int main(void)
+{
+	DBusConnection *client;
+	DBusError error = DBUS_ERROR_INIT;
+	struct btd_device device = { 0 };
+	struct btd_device replacement = { 0 };
+	/* A ready-registration owns the retired watch until its callback is
+	 * destroyed, even if unregister cannot remove the registration. */
+	struct ubm_client_watch *held = g_new0(struct ubm_client_watch, 1);
+	held->refs = 1;
+	held->device = &replacement;
+	replacement.ubm_watch = held;
+	ubm_watch_ref(held);
+	ubm_watch_retire(&replacement);
+	assert(!replacement.ubm_watch && held->refs == 1);
+	assert(!ubm_watch_current(held));
+	ubm_discovery_observed(false, false, EIO, 0, held);
+	assert(!held->device);
+	ubm_watch_unref(held);
+	struct ubm_client_watch old_watch = { .device = &device };
+	struct ubm_client_watch watch = { .device = &device, .attachment = 1,
+							.initial_ready = true };
+	device.le_state.connected = true;
+	ubm_le_physical_connected(&device);
+	uint64_t physical_generation = btd_device_ubm_le_generation(&device);
+	assert(physical_generation > 0);
+	ubm_le_physical_connected(&device);
+	assert(btd_device_ubm_le_generation(&device) == physical_generation);
+	ubm_le_physical_connected(&replacement);
+	assert(btd_device_ubm_le_generation(&replacement) > physical_generation);
+	ubm_le_physical_lost(&device, physical_generation);
+	assert(btd_device_ubm_le_generation(&device) == 0);
+	ubm_le_physical_connected(&device);
+	assert(btd_device_ubm_le_generation(&device) > btd_device_ubm_le_generation(&replacement));
+	ubm_le_physical_lost(&device, physical_generation);
+	assert(btd_device_ubm_le_generation(&device) != 0);
+	device.path = "/org/bluez/test";
+	/* Exercise the exact production policy decision, before allocation. */
+	ubm_attach_primary(&device, BDADDR_LE_PUBLIC);
+	assert(ubm_fresh_initial_gatt(&device));
+	device.ubm_gatt.bearer = UBM_GATT_LE;
+	assert(ubm_fresh_initial_gatt(&device));
+	device.ubm_gatt.bearer = UBM_GATT_MIXED;
+	assert(!ubm_fresh_initial_gatt(&device));
+	device.ubm_gatt.bearer = UBM_GATT_LE;
+	btd_opts.reverse_discovery = false;
+	btd_opts.gatt_client = true;
+	assert(!ubm_gatt_init_allowed(&device));
+	assert(device.ubm_gatt.status == UBM_GATT_UNSUPPORTED);
+	ubm_gatt_begin(&device.ubm_gatt);
+	btd_opts.reverse_discovery = true;
+	btd_opts.gatt_client = false;
+	assert(!ubm_gatt_init_allowed(&device));
+	assert(device.ubm_gatt.status == UBM_GATT_UNSUPPORTED);
+	btd_opts.gatt_client = true;
+	assert(ubm_gatt_init_allowed(&device));
+	ubm_gatt_registration_failed(&device);
+	assert(device.ubm_gatt.status == UBM_GATT_FAILED);
+	assert(!strcmp(device.ubm_gatt.failure_stage, "registration"));
+	ubm_gatt_detach(&device.ubm_gatt);
+	ubm_attach_primary(&replacement, 255);
+	assert(!ubm_fresh_initial_gatt(&replacement));
+	ubm_gatt_complete(&replacement.ubm_gatt, true, 0);
+	assert(replacement.ubm_gatt.status == UBM_GATT_UNSUPPORTED);
+	/* This independent device must not alter the first receipt's identity. */
+	ubm_attachment_serial = 0;
+	ubm_attach_primary(&device, BDADDR_LE_PUBLIC);
+	ubm_gatt_complete(&device.ubm_gatt, true, 0);
+	device.ubm_watch = &watch;
+	ubm_discovery_observed(true, false, 0, 0, &old_watch);
+	assert(device.ubm_gatt.status == UBM_GATT_READY);
+	dbus_conn = g_dbus_setup_private(DBUS_BUS_SESSION, "org.ubm.Test", &error);
+	assert(dbus_conn);
+	client = g_dbus_setup_private(DBUS_BUS_SESSION, NULL, &error);
+	assert(client);
+	assert(g_dbus_register_interface(dbus_conn, device.path,
+		UBM_LE_GATT_INTERFACE, ubm_gatt_methods, ubm_gatt_signals,
+						NULL, &device, NULL));
+	loop = g_main_loop_new(NULL, FALSE);
+	snapshot(client, "ready", "none", 0);
+	projection_complete = false;
+	snapshot(client, "failed", "projection", EIO);
+	projection_complete = true;
+	ubm_discovery_observed(true, false, 0, 0, &watch);
+	snapshot(client, "discovering", "none", 0);
+	ubm_discovery_observed(false, false, EIO, 0x05, &watch);
+	snapshot(client, "failed", "discovery", EIO);
+	ubm_discovery_observed(false, true, 0, 0, &watch);
+	snapshot(client, "ready", "none", 0);
+	device.le_state.connected = false;
+	snapshot(client, "disconnected", "transport", ENOTCONN);
+	device.le_state.connected = true;
+	ubm_gatt_attach(&device.ubm_gatt, UBM_GATT_BREDR);
+	assert(!ubm_fresh_initial_gatt(&device));
+	snapshot(client, "unsupported", "bearer", EOPNOTSUPP);
+	/* The actual wrapper rejects an old completion after a new ATT epoch,
+	 * even if that old watch is still presented as the device's watch. */
+	ubm_gatt_detach(&device.ubm_gatt);
+	ubm_attach_primary(&replacement, BDADDR_LE_PUBLIC);
+	ubm_attach_primary(&device, BDADDR_LE_PUBLIC);
+	assert(device.ubm_gatt.attachment != replacement.ubm_gatt.attachment);
+	assert(device.ubm_gatt.attachment != watch.attachment);
+	ubm_discovery_observed(false, true, 0, 0, &watch);
+	assert(device.ubm_gatt.status == UBM_GATT_DISCOVERING);
+	snapshot(client, "discovering", "none", 0);
+	/* The same physical generation still rejects a stale client identity. */
+	watch.attachment = device.ubm_gatt.attachment;
+	watch.client = (struct bt_gatt_client *) &old_watch;
+	ubm_discovery_observed(false, true, 0, 0, &watch);
+	assert(device.ubm_gatt.status == UBM_GATT_DISCOVERING);
+	/* Exhaustion never recycles a ready receipt, across device recreation. */
+	ubm_attachment_serial = UINT64_MAX;
+	ubm_gatt_detach(&device.ubm_gatt);
+	ubm_attach_primary(&device, BDADDR_LE_PUBLIC);
+	ubm_gatt_complete(&device.ubm_gatt, true, 0);
+	snapshot(client, "failed", "generation", EOVERFLOW);
+	g_dbus_unregister_interface(dbus_conn, device.path, UBM_LE_GATT_INTERFACE);
+	g_main_loop_unref(loop);
+	dbus_connection_close(client);
+	dbus_connection_unref(client);
+	dbus_connection_close(dbus_conn);
+	dbus_connection_unref(dbus_conn);
+	puts("Production private method/ownership/error envelope: OK");
+	return 0;
+}
--- a/unit/test-ubm-gatt-projection.c
+++ b/unit/test-ubm-gatt-projection.c
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Exercise the production graph predicate; no system bus or radio. */
+#include "src/gatt-client.c"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void)
+{
+	struct btd_gatt_client client = { .ready = true };
+	struct service service = { .client = &client };
+	struct characteristic chrc = { .service = &service };
+	struct descriptor descriptor = { .chrc = &chrc };
+	struct service included = { .client = &client };
+	struct gatt_db_attribute *attr, *value;
+	struct gatt_db *stale_db;
+	bt_uuid_t uuid;
+	client.db = gatt_db_new();
+	client.services = queue_new();
+	service.chrcs = queue_new();
+	service.incl_services = queue_new();
+	chrc.descs = queue_new();
+	assert(btd_gatt_client_projection_complete(&client));
+	bt_uuid16_create(&uuid, 0x180d);
+	attr = gatt_db_add_service(client.db, &uuid, true, 8);
+	assert(attr);
+	gatt_db_service_set_active(attr, true);
+	gatt_db_attribute_get_service_data(attr, &service.start_handle,
+		&service.end_handle, &service.primary, &service.uuid);
+	/* Native discovery succeeded, but service export failed. */
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_push_tail(client.services, &service);
+	assert(btd_gatt_client_projection_complete(&client));
+	bt_uuid16_create(&uuid, 0x2a37);
+	value = gatt_db_service_add_characteristic(attr, &uuid, 0, 2,
+						NULL, NULL, NULL);
+	assert(value);
+	/* Surviving service object does not hide failed characteristic export. */
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.attr = value;
+	gatt_db_attribute_get_char_data(gatt_db_get_attribute(client.db,
+		gatt_db_attribute_get_handle(value) - 1), &chrc.handle,
+		&chrc.value_handle, &chrc.props, &chrc.ext_props, &chrc.uuid);
+	queue_push_tail(service.chrcs, &chrc);
+	assert(btd_gatt_client_projection_complete(&client));
+	/* Exported characteristic owns the value attribute, not declaration. */
+	chrc.attr = gatt_db_get_attribute(client.db, chrc.handle);
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.attr = value;
+	stale_db = gatt_db_clone(client.db);
+	assert(stale_db);
+	chrc.attr = gatt_db_get_attribute(stale_db, chrc.value_handle);
+	assert(chrc.attr && chrc.attr != value);
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.attr = value;
+	gatt_db_unref(stale_db);
+	chrc.attr = NULL;
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.attr = value;
+	chrc.handle++;
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.handle--;
+	chrc.value_handle++;
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.value_handle--;
+	assert(btd_gatt_client_projection_complete(&client));
+	bt_uuid16_create(&uuid, 0x2902);
+	descriptor.attr = gatt_db_service_add_descriptor(attr, &uuid, 0,
+						NULL, NULL, NULL);
+	assert(descriptor.attr);
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_push_tail(chrc.descs, &descriptor);
+	descriptor.handle = gatt_db_attribute_get_handle(descriptor.attr);
+	descriptor.uuid = *gatt_db_attribute_get_type(descriptor.attr);
+	assert(btd_gatt_client_projection_complete(&client));
+	chrc.props = 0;
+	assert(!btd_gatt_client_projection_complete(&client));
+	chrc.props = 2;
+	/* D-Bus Includes intentionally deduplicates multiple native declarations
+	 * that point to one service. Completeness is about exported unique edges. */
+	bt_uuid16_create(&uuid, 0x180f);
+	value = gatt_db_add_service(client.db, &uuid, true, 4);
+	assert(value);
+	gatt_db_service_set_active(value, true);
+	included.chrcs = queue_new();
+	included.incl_services = queue_new();
+	gatt_db_attribute_get_service_data(value, &included.start_handle,
+		&included.end_handle, &included.primary, &included.uuid);
+	queue_push_tail(client.services, &included);
+	assert(gatt_db_service_add_included(attr, value));
+	assert(gatt_db_service_add_included(attr, value));
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_push_tail(service.incl_services, &included);
+	assert(btd_gatt_client_projection_complete(&client));
+	included.end_handle++;
+	assert(!btd_gatt_client_projection_complete(&client));
+	included.end_handle--;
+	queue_remove(service.incl_services, &included);
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_push_tail(service.incl_services, &included);
+	/* Extra cached objects are also not a complete current projection. */
+	queue_push_tail(chrc.descs, &descriptor);
+	assert(!btd_gatt_client_projection_complete(&client));
+	queue_destroy(chrc.descs, NULL);
+	queue_destroy(included.chrcs, NULL);
+	queue_destroy(included.incl_services, NULL);
+	queue_destroy(service.incl_services, NULL);
+	queue_destroy(service.chrcs, NULL);
+	queue_destroy(client.services, NULL);
+	gatt_db_unref(client.db);
+	puts("Production export graph completeness: OK");
+	return 0;
+}
--- a/unit/test-ubm-gatt-state.c
+++ b/unit/test-ubm-gatt-state.c
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include "src/ubm-gatt-state.h"
+
+int main(void)
+{
+	struct ubm_gatt_state state = { 0 };
+	uint64_t attachment, revision;
+	struct ubm_gatt_refresh refresh = { 0 };
+
+	ubm_gatt_refresh_begin(&refresh);
+	ubm_gatt_refresh_begin(&refresh);
+	assert(!ubm_gatt_refresh_finish(&refresh, false, 0x05));
+	assert(refresh.pending == 1 && refresh.failed && refresh.att_error == 5);
+	assert(ubm_gatt_refresh_finish(&refresh, true, 0));
+	assert(refresh.failed && refresh.att_error == 5);
+	ubm_gatt_refresh_begin(&refresh);
+	assert(!refresh.failed);
+	assert(ubm_gatt_refresh_finish(&refresh, true, 0));
+	assert(!refresh.failed && refresh.pending == 0);
+	refresh.pending = UINT64_MAX;
+	ubm_gatt_refresh_begin(&refresh);
+	assert(refresh.exhausted && refresh.failed);
+	assert(!ubm_gatt_refresh_finish(&refresh, true, 0));
+	assert(refresh.pending == UINT64_MAX);
+
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCONNECTED);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	attachment = state.attachment;
+	assert(attachment != 0);
+	ubm_gatt_begin(&state);
+	revision = state.revision;
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCOVERING);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_READY);
+	assert(state.attachment == attachment && state.revision == revision);
+	ubm_gatt_retire(&state);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	ubm_gatt_complete(&state, true, 0);
+	assert(state.status == UBM_GATT_DISCONNECTED && state.attachment == attachment);
+	ubm_gatt_detach(&state);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	attachment = state.attachment;
+	ubm_gatt_complete(&state, true, 0);
+
+	/* An accepted invalidation precedes completion/export of a refresh. */
+	ubm_gatt_begin(&state);
+	assert(state.revision > revision);
+	assert(ubm_gatt_status(&state) != UBM_GATT_READY);
+	ubm_gatt_complete(&state, false, 0x05);
+	assert(ubm_gatt_status(&state) == UBM_GATT_FAILED);
+	assert(state.error == EIO && state.att_error == 0x05);
+	ubm_gatt_begin(&state);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_READY);
+
+	/* A second transport cannot turn the shared client into LE evidence. */
+	ubm_gatt_attach(&state, UBM_GATT_BREDR);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_UNSUPPORTED);
+	assert(state.bearer == UBM_GATT_MIXED && state.error == EOPNOTSUPP);
+	ubm_gatt_detach(&state);
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCONNECTED);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCONNECTED);
+	ubm_gatt_attach(&state, UBM_GATT_BREDR);
+	ubm_gatt_begin(&state);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_UNSUPPORTED);
+	ubm_gatt_detach(&state);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	assert(state.attachment > attachment);
+	assert(ubm_gatt_status(&state) == UBM_GATT_DISCOVERING);
+
+	/* Counter wrap is a terminal refusal, never a recycled receipt. */
+	state.revision = UINT64_MAX;
+	ubm_gatt_begin(&state);
+	ubm_gatt_complete(&state, true, 0);
+	assert(ubm_gatt_status(&state) == UBM_GATT_FAILED);
+	assert(state.error == EOVERFLOW);
+	ubm_gatt_detach(&state);
+	assert(state.status == UBM_GATT_FAILED && state.error == EOVERFLOW);
+	ubm_gatt_attach(&state, UBM_GATT_LE);
+	ubm_gatt_complete(&state, true, 0);
+	assert(state.status == UBM_GATT_FAILED && state.error == EOVERFLOW);
+	puts("LE GATT ownership/status lifecycle: OK");
+	return 0;
+}
