+static void notify_reply(GDBusReturnFunction callback, void *data,
+					GDBusDestroyFunction destroy, bool failure)
+{
+	DBusMessage *reply;
+	int sockets[2];
+	uint16_t mtu = capture_options ? acquired_mtu : 23;
+	if (failure) {
+		reply = dbus_message_new(DBUS_MESSAGE_TYPE_ERROR);
+		assert(dbus_message_set_error_name(reply, ERROR_FAILED));
+	} else {
+		reply = dbus_message_new(DBUS_MESSAGE_TYPE_METHOD_RETURN);
+		assert(!socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sockets));
+		/* Each fixture retains only its latest application-side writer. */
+		if (writer_fd >= 0) close(writer_fd);
+		writer_fd = sockets[1];
+		assert(dbus_message_append_args(reply, DBUS_TYPE_UNIX_FD, &sockets[0],
+			DBUS_TYPE_UINT16, &mtu, DBUS_TYPE_INVALID));
+		close(sockets[0]);
+	}
+	callback(reply, data);
+	dbus_message_unref(reply);
+	if (destroy) destroy(data);
+}
+static void finish_notify(unsigned int index, bool failure)
+{
+	assert(index < pending_count && pending[index].data);
+	notify_reply(pending[index].callback, pending[index].data,
+					pending[index].destroy, failure);
+	pending[index].data = NULL;
+}
+gboolean g_dbus_proxy_method_call(GDBusProxy *proxy, const char *method,
+		GDBusSetupFunction setup, GDBusReturnFunction callback,
+		void *data, GDBusDestroyFunction destroy)
+{
+	if (!strcmp(method, "AcquireNotify")) {
+		enables++;
+		if (capture_options && setup) {
+			DBusMessage *request = dbus_message_new(DBUS_MESSAGE_TYPE_METHOD_CALL);
+			DBusMessageIter iter;
+			dbus_message_iter_init_append(request, &iter);
+			setup(&iter, data);
+			dbus_message_unref(request);
+		}
+		if (refuse) return false;
+		if (delayed) {
+			assert(pending_count < 32);
+			pending[pending_count].callback = callback;
+			pending[pending_count].data = data;
+			pending[pending_count++].destroy = destroy;
+		} else notify_reply(callback, data, destroy, false);
+	} else if (!strcmp(method, "StartNotify")) starts++;
+	else if (!strcmp(method, "StopNotify")) stops++;
+	else assert(false);
+	return true;
+}
