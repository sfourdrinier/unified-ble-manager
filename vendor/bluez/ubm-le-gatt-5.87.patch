+static void ubm_discovery_begin(struct bt_gatt_client *client)
+{
+	/* Clones share the parent's database and hold a reference to it. */
+	while (client->parent)
+		client = client->parent;
+	ubm_gatt_refresh_begin(&client->ubm_refresh);
+	if (client->ubm_observer)
+		client->ubm_observer(true, false,
+			client->ubm_refresh.exhausted ? EOVERFLOW : 0, 0,
+							client->ubm_data);
