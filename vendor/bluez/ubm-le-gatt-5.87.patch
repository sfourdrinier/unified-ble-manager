+static void ubm_gatt_registration_failed(struct btd_device *device)
+{
+	ubm_gatt_complete(&device->ubm_gatt, false, 0);
+	if (!device->ubm_gatt.exhausted)
+		device->ubm_gatt.failure_stage = "registration";
+	ubm_emit(device);
+}
