+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef UBM_GATT_STATE_H
+#define UBM_GATT_STATE_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <errno.h>
+
+enum ubm_gatt_bearer { UBM_GATT_NONE, UBM_GATT_LE, UBM_GATT_BREDR,
+							UBM_GATT_MIXED, UBM_GATT_UNKNOWN };
+enum ubm_gatt_status { UBM_GATT_DISCONNECTED, UBM_GATT_DISCOVERING,
+	UBM_GATT_READY, UBM_GATT_FAILED, UBM_GATT_UNSUPPORTED };
+struct ubm_gatt_state {
+	uint64_t attachment;
+	uint64_t revision;
+	enum ubm_gatt_bearer bearer;
+	enum ubm_gatt_status status;
+	int error;
+	uint8_t att_error;
+	const char *failure_stage;
+	bool exhausted;
+	bool retired;
+};
+
+/* One cycle includes every accepted queued invalidation and hash check. */
+struct ubm_gatt_refresh {
+	uint64_t pending;
+	bool failed;
+	bool exhausted;
+	uint8_t att_error;
+};
+static inline void ubm_gatt_refresh_begin(struct ubm_gatt_refresh *refresh)
+{
+	if (!refresh->pending && !refresh->exhausted) {
+		refresh->failed = false;
+		refresh->att_error = 0;
+	}
+	if (refresh->pending == UINT64_MAX) {
+		refresh->failed = true;
+		refresh->exhausted = true;
+		return;
+	}
+	refresh->pending++;
+}
+static inline bool ubm_gatt_refresh_finish(struct ubm_gatt_refresh *refresh,
+						bool success, uint8_t att_error)
+{
+	if (refresh->exhausted)
+		return false;
+	if (!success && !refresh->failed) {
+		refresh->failed = true;
+		refresh->att_error = att_error;
+	}
+	if (refresh->pending)
+		refresh->pending--;
+	return !refresh->pending;
+}
+
+static inline enum ubm_gatt_status ubm_gatt_status(
+					const struct ubm_gatt_state *state)
+{
+	return state->status;
+}
+
+static inline void ubm_gatt_begin(struct ubm_gatt_state *state)
+{
+	if (state->revision == UINT64_MAX || state->exhausted) {
+		state->exhausted = true;
+		state->status = UBM_GATT_FAILED;
+		state->error = EOVERFLOW;
+		state->failure_stage = NULL;
+		return;
+	}
+	state->revision++;
+	state->att_error = 0;
+	state->failure_stage = NULL;
+	if (state->bearer == UBM_GATT_NONE || state->retired) {
+		state->status = UBM_GATT_DISCONNECTED;
+		state->error = ENOTCONN;
+		return;
+	}
+	state->error = state->bearer == UBM_GATT_LE ? 0 : EOPNOTSUPP;
+	state->status = state->bearer == UBM_GATT_LE ?
+				UBM_GATT_DISCOVERING : UBM_GATT_UNSUPPORTED;
+}
+
+/* The caller supplies only a bearer read from the accepted ATT socket. */
+static inline void ubm_gatt_attach(struct ubm_gatt_state *state,
+						enum ubm_gatt_bearer bearer)
+{
+	if (state->bearer != UBM_GATT_NONE) {
+		if (state->bearer != bearer) {
+			state->bearer = UBM_GATT_MIXED;
+			ubm_gatt_begin(state);
+		}
+		return;
+	}
+	if (state->attachment == UINT64_MAX) {
+		state->exhausted = true;
+		ubm_gatt_begin(state);
+		return;
+	}
+	state->attachment++;
+	state->retired = false;
+	state->bearer = bearer;
+	ubm_gatt_begin(state);
+}
+
+static inline void ubm_gatt_complete(struct ubm_gatt_state *state,
+						bool success, uint8_t att_error)
+{
+	if (state->exhausted || state->retired || state->bearer == UBM_GATT_NONE)
+		return;
+	if (state->bearer != UBM_GATT_LE) {
+		state->status = UBM_GATT_UNSUPPORTED;
+		state->error = EOPNOTSUPP;
+		return;
+	}
+	state->status = success ? UBM_GATT_READY : UBM_GATT_FAILED;
+	state->failure_stage = NULL;
+	state->error = success ? 0 : EIO;
+	state->att_error = att_error;
+}
+
+static inline void ubm_gatt_retire(struct ubm_gatt_state *state)
+{
+	ubm_gatt_begin(state);
+	state->retired = true;
+	if (state->exhausted)
+		return;
+	state->status = UBM_GATT_DISCONNECTED;
+	state->error = ENOTCONN;
+	state->att_error = 0;
+}
+static inline void ubm_gatt_detach(struct ubm_gatt_state *state)
+{
+	ubm_gatt_retire(state);
+	state->bearer = UBM_GATT_NONE;
+}
+#endif
