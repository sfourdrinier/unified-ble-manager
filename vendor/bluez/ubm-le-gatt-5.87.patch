+/* Called only after the primary ATT socket was accepted and classified. */
+static void ubm_attach_primary(struct btd_device *device, uint8_t dst_type)
+{
+	if (ubm_attachment_serial == UINT64_MAX)
+		device->ubm_gatt.exhausted = true;
+	else
+		device->ubm_gatt.attachment = ubm_attachment_serial++;
+	ubm_gatt_attach(&device->ubm_gatt, ubm_socket_bearer(dst_type));
+	ubm_emit(device);
+}
+
+static DBusMessage *ubm_get_snapshot(DBusConnection *conn, DBusMessage *msg,
+							void *data)
+{
+	struct btd_device *device = data;
+	struct ubm_gatt_state state = device->ubm_gatt;
+	uint32_t version = 1;
+	const char *bearers[] = { "none", "le", "bredr", "mixed", "unknown" };
+	const char *statuses[] = { "disconnected", "discovering", "ready",
+						"failed", "unsupported" };
+	const char *bearer, *status, *error_stage = state.failure_stage ?
+						state.failure_stage : "none";
+	int32_t error;
+	DBusMessage *reply;
+	(void) conn;
+	/* The method is read-only. Even a successful native refresh is not a
+	 * usable D-Bus database if export failed or the LE link has gone away. */
+	if (state.bearer == UBM_GATT_LE && !device->le_state.connected) {
+		state.status = UBM_GATT_DISCONNECTED;
+		state.error = ENOTCONN;
+		error_stage = "transport";
+	}
+	if (state.status == UBM_GATT_READY &&
+			!btd_gatt_client_projection_complete(device->client_dbus)) {
+		state.status = UBM_GATT_FAILED;
+		state.error = EIO;
+		error_stage = "projection";
+	}
+	if (!strcmp(error_stage, "none") && state.error)
+		error_stage = state.error == EOVERFLOW ? "generation" :
+			state.status == UBM_GATT_UNSUPPORTED ? "bearer" :
+			state.status == UBM_GATT_DISCONNECTED ? "transport" : "discovery";
+	bearer = bearers[state.bearer];
+	status = statuses[state.status];
+	error = state.error;
+	reply = dbus_message_new_method_return(msg);
+	if (!reply)
+		return NULL;
+	dbus_message_append_args(reply, DBUS_TYPE_UINT32, &version,
+			DBUS_TYPE_UINT64, &state.attachment,
+			DBUS_TYPE_UINT64, &state.revision,
+			DBUS_TYPE_STRING, &bearer, DBUS_TYPE_STRING, &status,
+			DBUS_TYPE_STRING, &error_stage,
+			DBUS_TYPE_INT32, &error, DBUS_TYPE_BYTE, &state.att_error,
+			DBUS_TYPE_INVALID);
+	return reply;
+}
+
+static const GDBusMethodTable ubm_gatt_methods[] = {
