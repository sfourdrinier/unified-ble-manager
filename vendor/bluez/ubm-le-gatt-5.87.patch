+static uint64_t ubm_attachment_serial;
+static uint64_t ubm_le_physical_serial;
+
+/* Physical LE ownership is not ATT discovery ownership. Only actual kernel
+ * connection admission/loss may advance or retire this identity. */
+static void ubm_le_physical_connected(struct btd_device *device)
+{
+	if (device->ubm_le_physical_generation)
+		return;
+	if (ubm_le_physical_serial == UINT64_MAX)
+		return;
+	device->ubm_le_physical_generation = ++ubm_le_physical_serial;
+}
+
+static void ubm_le_physical_lost(struct btd_device *device, uint64_t generation)
+{
+	if (generation && device->ubm_le_physical_generation == generation)
+		device->ubm_le_physical_generation = 0;
+}
+
+uint64_t btd_device_ubm_le_generation(struct btd_device *device)
+{
+	return device->ubm_le_physical_generation;
+}
+
+void btd_device_ubm_le_generation_lost(struct btd_device *device,
+						uint64_t generation)
+{
+	ubm_le_physical_lost(device, generation);
+}
+struct ubm_client_watch {
