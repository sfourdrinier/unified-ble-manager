+static bool ubm_watch_current(struct ubm_client_watch *watch)
+{
+	return watch && watch->device->ubm_watch == watch &&
+		watch->device->client == watch->client &&
+		!watch->device->ubm_gatt.retired &&
+		watch->device->ubm_gatt.attachment == watch->attachment;
+}
+
+static void ubm_discovery_observed(bool pending, bool success,
+					int error, uint8_t att_error, void *data)
+{
+	struct ubm_client_watch *watch = data;
+	struct btd_device *device = watch->device;
+	if (!ubm_watch_current(watch))
+		return;
+	watch->pending = pending;
+	if (error == EOVERFLOW)
+		device->ubm_gatt.exhausted = true;
+	if (pending) {
+		ubm_gatt_begin(&device->ubm_gatt);
+	} else {
+		watch->refresh_failed = !success;
+		watch->att_error = att_error;
+		if (watch->initial_ready)
+			ubm_gatt_complete(&device->ubm_gatt, success, att_error);
+	}
+	ubm_emit(device);
+}
