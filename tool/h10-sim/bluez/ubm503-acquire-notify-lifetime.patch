 }
 
+static void indication_guard_destroy(void *user_data)
+{
+	struct indication_guard *guard = user_data;
+	bool release;
+
+	release = !guard->callback_released;
+	if (release)
+		guard->callback_released = true;
+
+	if (release)
+		indication_guard_release(guard);
+}
+
+static struct indication_guard *indication_guard_new(void *user_data)
+{
+	struct client_io *client = user_data;
+	struct indication_guard *guard;
+
+	if (!client || !client_io_ref_if_live(client))
+		return NULL;
+
+	guard = new0(struct indication_guard, 1);
+	if (!guard) {
+		client_io_release(client);
+		return NULL;
+	}
+	guard->client = client;
+	guard->refs = 2;
+	return guard;
+}
+
+static void indication_guard_finish(struct indication_guard *guard, bool sent)
+{
+	bool release_callback;
+
+	if (!sent) {
+		release_callback = !guard->callback_released;
+		if (release_callback)
+			guard->callback_released = true;
+		if (release_callback)
+			indication_guard_release(guard);
+	}
+
+	/* The caller reference is always released; a synchronous destroy may
+	 * already have released the callback reference on a failed send. */
+	indication_guard_release(guard);
+}
+
+static void sock_io_conf(void *user_data)
+{
+	struct indication_guard *guard = user_data;
+	struct client_io *client = guard->client;
+
+	if (!client->retired && client->io)
+		io_set_write_handler(client->io, sock_io_write, NULL, NULL);
+}
