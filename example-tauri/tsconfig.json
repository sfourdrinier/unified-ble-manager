{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "paths": {
      "unified-ble-manager": ["../lib/typescript/module/src/index.d.ts"],
      "unified-ble-manager/package.json": ["../package.json"],
      "unified-ble-manager/*": ["../lib/typescript/module/src/*"]
    }
  },
  "include": ["src", "vite.config.mts", "../examples-shared/driver/**/*.ts"]
}
