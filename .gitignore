# .gitignore

# OSX
#
.DS_Store

# Xcode
#
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
project.xcworkspace
.xcode.env.local

Pods/

# Android/IntelliJ
#
build/
.cxx/
.idea
.gradle
*.iml
*.swp
*.bat
local.properties

# node.js
#
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log*

# BUCK
buck-out/
\.buckd/
*.keystore
!example/android/app/debug.keystore

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

*/fastlane/report.xml
*/fastlane/Preview.html
*/fastlane/screenshots

# Tauri plugin is a library crate. Do not commit its build tree or lockfile.
# example-tauri/src-tauri/Cargo.lock stays tracked (that crate is an app).
native/tauri/target/
native/tauri/Cargo.lock
# The example app's build tree and Tauri's generated scaffolding are
# outputs of `cargo check`/`tauri build`, not sources.
example-tauri/src-tauri/target/
example-tauri/src-tauri/gen/

# UBM 5.0 Rust workspace build trees (root workspace, crates, bindings).
/target/
crates/*/target/
bindings/*/target/

# HOST-ANDROID (UBM 5.0): the library's committed release prebuilts ship to
# packed consumers (built by android/refresh-prebuilt-jniLibs.sh); only the
# exact shipped paths are tracked, everything else under jniLibs stays out.
android/src/main/jniLibs/*
!android/src/main/jniLibs/build-identity.txt
!android/src/main/jniLibs/arm64-v8a/
!android/src/main/jniLibs/x86_64/
android/src/main/jniLibs/arm64-v8a/*
!android/src/main/jniLibs/arm64-v8a/libubm5_jni_echo.so
android/src/main/jniLibs/x86_64/*
!android/src/main/jniLibs/x86_64/libubm5_jni_echo.so
# The probe app stages its own cdylib per build: still untracked outputs.
emulator-probe/five0/probe-app/app/src/main/jniLibs/
# HOST-ANDROID (UBM 5.0): five0 battery raw logs are local evidence only;
# the committed record is results-five0.json. Never commit logs/.
emulator-probe/five0/logs/
# U9 restart-recovery battery: same rule — results-u9.json is the record.
emulator-probe/u9/logs/

# Bundle artifact
*.jsbundle
/.artifacts/
/lib
/test_project
/example-web/dist/
*.tsbuildinfo

# Example app installs via pnpm (bootstrap / CI). No committed lock yet:
# - pnpm-lock is local until we choose to pin it
# - yarn.lock is not used (stale Yarn v1 lock removed after floating RN ranges)
example/pnpm-lock.yaml
example/yarn.lock

# Generated by CocoaPods for the non-Expo example; regenerate locally on macOS.
example/vendor/bundle/
example/ios/Pods/
example/ios/build/
example/ios/Podfile.lock

# Built by ios/build-rust-core.sh via the podspec prepare_command at pod
# install; never shipped, always rebuilt from bindings/uniffi sources.
ios/RustCore/
