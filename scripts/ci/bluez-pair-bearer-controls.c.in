static GSList *g_slist_prepend(GSList *list, void *data) {
 GSList *node=calloc(1,sizeof(*node)); assert(node); node->data=data; node->next=list; return node;
}
static GSList *g_slist_find(GSList *list, void *data) {
 for (;list;list=list->next) if(list->data==data) return list; return NULL;
}
static GSList *g_slist_remove(GSList *list, void *data) {
 GSList **slot=&list; while(*slot) { if((*slot)->data==data) { GSList *old=*slot; *slot=old->next; free(old); break; } slot=&(*slot)->next; } return list;
}
static GSList *g_slist_delete_link(GSList *list, GSList *node) { return g_slist_remove(list,node->data); }
static unsigned int g_slist_length(GSList *list) { unsigned int count=0; for(;list;list=list->next)count++; return count; }
static DBusConnection *btd_get_dbus_connection(void) { return NULL; }
static const char *dbus_message_get_sender(DBusMessage *message) { return message->sender; }
static const char *dbus_message_get_member(DBusMessage *message) { return message->member; }
static DBusMessage *dbus_message_ref(DBusMessage *msg) { msg->refs++; return msg; }
static void dbus_message_unref(DBusMessage *msg) { assert(msg && msg->refs); msg->refs--; }
static unsigned int watch_id;
static guint g_dbus_add_disconnect_watch(DBusConnection *conn,const char *sender,void (*cb)(DBusConnection*,void*),void *data,void *destroy) { return ++watch_id; }
static void g_dbus_remove_watch(DBusConnection *conn,guint watch) {}
struct idle { gboolean (*cb)(void*); void *data; struct idle *next; };
static struct idle *idle_queue;
static unsigned int g_idle_add(gboolean (*callback)(void*),void *data) {
 struct idle *job=calloc(1,sizeof(*job)); job->cb=callback; job->data=data;
 struct idle **slot=&idle_queue; while(*slot)slot=&(*slot)->next; *slot=job; return 1;
}
static void run_idle(void) { unsigned int watchdog=0; while(idle_queue) { assert(watchdog++<10000); struct idle *job=idle_queue; idle_queue=job->next; job->cb(job->data); free(job); } }
static struct btd_adapter *device_get_adapter(struct btd_device *device) { return &adapter; }
