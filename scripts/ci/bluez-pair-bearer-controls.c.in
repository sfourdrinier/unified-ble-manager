{{FUNCTION:device_bonding_complete}}

static DBusMessage arriving={.sender=":1.ubm",.member="ConnectLease",.refs=1};
static struct lease *owned(struct peer *peer) {
 struct lease *lease=calloc(1,sizeof(*lease)); assert(lease);
 lease->peer=peer; lease->sender=strdup(":1.ubm"); lease->path=strdup("/dev/test");
 lease->generation=peer->generation; leases=g_slist_prepend(leases,lease); return lease;
}
static struct lease *exclusive_arrival(struct btd_device *device, uint64_t generation) {
 struct peer *peer=get_peer(device); struct lease *lease=owned(peer);
 lease->connecting=true; lease->accepted=true; lease->connect=dbus_message_ref(&arriving);
 device->generation=generation; btd_ubm_le_connected(device,generation,true);
 assert(peer->born_exclusive && peer->origin==ORIGIN_DAEMON_AUTO); return lease;
}
static void release_exclusive(struct lease *lease) {
 unsigned int before=disconnect_calls; lease->released=true; release_peer(lease);
 assert(disconnect_calls==before+1 && lease->peer->releasing);
}
int main(void) {
 static struct bt_att att[7]; static struct btd_device devices[7];
 static DBusMessage requests[7];
 for (unsigned int i=0;i<7;i++) {
  devices[i]=(struct btd_device){.adapter=&adapter,.initiator=true,.bdaddr_type=BDADDR_BREDR,
   .le=(void*)1,.bredr=(void*)2,.att=&att[i]};
  requests[i]=(DBusMessage){.sender=":1.external",.member="Pair",.refs=1};
 }
 selected_bearer=BDADDR_BREDR;
 // Classic acceptance during LE release must select the independent bearer.
 struct peer *releasing=get_peer(&devices[0]); releasing->releasing=true;
 unsigned int selected=bearer_selections, dispatched=classic_pairing_dispatches;
 assert(pair_device(NULL,&requests[0],&devices[0])==NULL);
 assert(bearer_selections==selected+1 && classic_pairing_dispatches==dispatched+1);
 assert(!find_admission_message(&requests[0]) && !releasing->interests);
 releasing->releasing=false;
 release_exclusive(exclusive_arrival(&devices[0],101));
 puts("PASS Classic accepted during LE release selects BR/EDR without LE ownership");
 // Production completion leaves no LE admission or fabricated LE origin.
 assert(pair_device(NULL,&requests[1],&devices[1])==NULL);
 devices[1].bredr_state.svc_resolved=true;
 device_bonding_complete(&devices[1],BDADDR_BREDR,0);
 assert(!devices[1].bonding && devices[1].bredr_state.paired);
 assert(!find_admission_message(&requests[1]));
 release_exclusive(exclusive_arrival(&devices[1],102));
 puts("PASS completed Classic Pair cannot protect an unrelated UBM-only LE arrival");
 // Refusal rolls back its native bonding request without creating LE records.
 classic_pairing_result=-EPERM;
 assert(pair_device(NULL,&requests[2],&devices[2])!=NULL);
 classic_pairing_result=0;
 assert(!devices[2].bonding && !find_admission_message(&requests[2]));
 release_exclusive(exclusive_arrival(&devices[2],103));
 puts("PASS refused Classic Pair leaves LE arrival and release exclusive");
 // Exact Pair sender-death callback reaches controlled native disconnect,
 // never an LE ledger owner. We measure the request boundary, not RF teardown.
 assert(pair_device(NULL,&requests[3],&devices[3])==NULL);
 unsigned int requests_before=request_disconnect_boundaries;
 create_bond_req_exit(NULL,&devices[3]);
 assert(request_disconnect_boundaries==requests_before+1);
 assert(!find_admission_message(&requests[3]));
 release_exclusive(exclusive_arrival(&devices[3],104));
 puts("PASS Classic sender death cannot leave false LE provenance");
 release_exclusive(exclusive_arrival(&devices[4],105));
 puts("PASS UBM-only LE arrival retains final physical disconnect request");
 // Real LE Pair remains protected for the whole accepted asynchronous lifetime.
 struct lease *le=exclusive_arrival(&devices[5],106);
 selected_bearer=BDADDR_LE_PUBLIC; devices[5].bdaddr_type=BDADDR_LE_PUBLIC;
 devices[5].le_state.connected=true;
 unsigned int before=disconnect_calls;
 assert(pair_device(NULL,&requests[5],&devices[5])==NULL);
 struct admission *admission=find_admission_message(&requests[5]);
 assert(admission && !admission->committed && protecting_interest(le->peer));
 le->released=true; release_peer(le);
 assert(disconnect_calls==before && !strcmp(le->receipt,"lease-released-protected"));
 btd_ubm_le_rollback(&devices[5],&requests[5]);
 assert(!find_admission_message(&requests[5]) && !protecting_interest(le->peer));
 release_peer(le); assert(disconnect_calls==before+1);
 puts("PASS pending LE Pair protects until rollback, then exact owner can release");
 // LE selection still refuses admission while its own bearer is releasing.
 struct peer *le_releasing=get_peer(&devices[6]); le_releasing->releasing=true;
 devices[6].bdaddr_type=BDADDR_LE_PUBLIC;
 assert(pair_device(NULL,&requests[6],&devices[6])!=NULL);
 assert(!devices[6].bonding && !find_admission_message(&requests[6]));
 puts("PASS LE Pair continues to refuse while LE release is active");
 puts("All production Pair/bearer controls passed (controlled native boundaries; no radio proof)");
 return 0;
}
